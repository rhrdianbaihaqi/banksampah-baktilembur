---
/**
 * Beranda — company profile dalam kemasan landing page (PRD §4).
 *
 * Hitungan seksi berlatar foto penuh, batas keras 6 (§6.5 aturan 8):
 *   1. BlokHero (S1 + S2 berbagi satu foto)
 *   2. S4 Alur
 *   3. S7 Hasil
 *   4. S10 Galeri
 *   5. S11 Kontak
 * Terpakai 5, tersisa jatah 1. S3, S6, S8 memakai latar netral;
 * S5 dan S9 memakai --brand-green-light.
 */
import Layout from "../layouts/Layout.astro";
import BlokHero from "../components/sections/BlokHero.astro";
import S1Hero from "../components/sections/S1Hero.astro";
import S2Angka from "../components/sections/S2Angka.astro";
import S3Latar from "../components/sections/S3Latar.astro";
import S4Alur from "../components/sections/S4Alur.astro";

import S6Jadwal from "../components/sections/S6Jadwal.astro";
import S7Hasil from "../components/sections/S7Hasil.astro";
import S8Produk from "../components/sections/S8Produk.astro";
import S9Bukti from "../components/sections/S9Bukti.astro";
import S10Galeri from "../components/sections/S10Galeri.astro";
import S11Kontak from "../components/sections/S11Kontak.astro";
import { profil } from "../data";
---

<Layout
	judul={`${profil.nama} — Pengelolaan Sampah Terpadu di Pasirwangi, Garut`}
	judulPenuh
	deskripsi="Bank Sampah Bakti Lembur mengelola sampah terpadu berbasis warga di Desa Sarimukti, Pasirwangi, Garut. Melayani 500+ kepala keluarga sejak April 2024."
>
	<main id="konten">
		{
			/* S1 dan S2 berbagi satu foto latar — §S2 menetapkan S2 memakai
		    lanjutan foto hero, bukan foto baru. */
		}
		<BlokHero />

		<S3Latar />
		<S4Alur />

		<S6Jadwal />
		<S7Hasil />
		<S8Produk />
		<S9Bukti />
		<S10Galeri />
		<S11Kontak />
	</main>
</Layout>
