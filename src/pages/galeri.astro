---
/**
 * Halaman Galeri Dokumentasi.
 * Menggunakan gaya Bento Grid untuk menampilkan foto kegiatan.
 */
import Layout from '../layouts/Layout.astro';
import { Image } from "astro:assets";
import { galeriTersaring } from '../data';
import Ikon from '../components/ui/Ikon.astro';

const kategori = galeriTersaring();

// Foto galeri dari folder assets
const berkas = import.meta.glob<{ default: ImageMetadata }>(
	"../assets/images/**/*.{jpg,JPG,jpeg,JPEG,png,PNG,avif,webp}",
);

const judulHalaman = "Galeri Kegiatan";
const deskripsi = "Dokumentasi foto aktivitas penimbangan, pengelolaan, dan kemitraan di Bank Sampah Bakti Lembur.";
---

<Layout judul={judulHalaman} deskripsi={deskripsi}>
	<main class="halaman-galeri latar-kaca">
		<header class="header-halaman">
			<div class="wadah">
				<a href="/#galeri" class="tombol-kembali">
					<Ikon nama="arrow-left" ukuran={16} />
					<span>Kembali ke Beranda</span>
				</a>
				<h1 class="judul-utama">Galeri <br/> <span class="stabilo-hijau">Bakti Lembur</span></h1>
				<p class="deskripsi-header">Jejak langkah, momen kolaborasi, dan dokumentasi pengelolaan lingkungan bersama warga.</p>
			</div>
		</header>

		<section class="konten-galeri">
			<div class="wadah">
				{kategori.length === 0 ? (
					<div class="galeri-kosong">
						<Ikon nama="image" ukuran={48} />
						<p>Dokumentasi foto sedang disiapkan tim KKN.</p>
					</div>
				) : (
					<div class="daftar-kategori">
						{kategori.map(kat => {
							if(kat.foto.length === 0) return null;
							
							return (
								<div class="kategori-seksi" id={kat.slug}>
									<div class="kategori-header">
										<h2 class="kategori-judul">{kat.judul}</h2>
										<div class="garis-aksen"></div>
									</div>
									
									<div class="bento-grid">
										{kat.foto.map((f, i) => {
											// Menentukan kelas rentang (span) bento berdasarkan indeks
											// Pola asimetris: kotak besar, kotak panjang, kotak kecil
											let spanClass = '';
											const pola = i % 6;
											
											if (pola === 0) spanClass = 'bento-besar';
											else if (pola === 1 || pola === 4) spanClass = 'bento-panjang';
											else if (pola === 5) spanClass = 'bento-lebar';
											else spanClass = 'bento-kecil';

											return (
												<figure class={`bento-item ${spanClass}`}>
													<div class="foto-wrap">
														<Image
															src={berkas[`../assets/images/${f.file}`]!()}
															alt={f.alt}
															widths={[400, 800, 1200]}
															sizes="(max-width: 600px) 100vw, (max-width: 900px) 50vw, 33vw"
															class="bento-img"
														/>
														<div class="overlay-kaca">
															<p class="caption">{f.alt}</p>
														</div>
													</div>
												</figure>
											);
										})}
									</div>
								</div>
							);
						})}
					</div>
				)}
			</div>
		</section>
	</main>
</Layout>

<style>
	/* Warna dan Latar */
	.latar-kaca {
		background-color: var(--neutral-50);
		background-image: 
			radial-gradient(at 0% 0%, rgba(22, 163, 74, 0.05) 0px, transparent 50%),
			radial-gradient(at 100% 100%, rgba(22, 163, 74, 0.08) 0px, transparent 50%);
		background-attachment: fixed;
		min-height: 100vh;
	}

	.wadah {
		max-width: 1120px;
		margin: 0 auto;
		padding: 0 calc(var(--space-unit) * 3);
	}

	/* Header Halaman */
	.header-halaman {
		padding-top: calc(var(--space-unit) * 12);
		padding-bottom: calc(var(--space-unit) * 6);
	}

	.tombol-kembali {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		color: var(--neutral-600);
		text-decoration: none;
		font-weight: 600;
		font-size: 0.95rem;
		margin-bottom: calc(var(--space-unit) * 4);
		transition: color 0.2s ease, transform 0.2s ease;
	}

	.tombol-kembali:hover {
		color: var(--brand-green);
		transform: translateX(-4px);
	}

	.judul-utama {
		font-family: var(--font-hero), system-ui, sans-serif;
		font-size: clamp(2.5rem, 6vw, 4rem);
		font-weight: 800;
		font-style: italic;
		letter-spacing: -0.02em;
		color: var(--neutral-900);
		line-height: 1.1;
		margin: 0 0 calc(var(--space-unit) * 2) 0;
	}

	.teks-aksen {
		color: var(--brand-green);
	}

	/* Efek Stabilo Hijau Muda pada Judul */
	.stabilo-hijau {
		position: relative;
		display: inline-block;
		white-space: nowrap;
		z-index: 1;
	}

	.stabilo-hijau::before {
		content: '';
		position: absolute;
		left: -4px;
		right: -4px;
		bottom: 10%;
		height: 36%;
		background: rgba(144, 238, 144, 0.7); /* Light green / hijau muda stabilo */
		z-index: -1;
		border-radius: 4px;
		transform: rotate(-1.5deg);
	}

	.deskripsi-header {
		font-size: 1.1rem;
		color: var(--neutral-700);
		max-width: 600px;
		line-height: 1.6;
		margin: 0;
	}

	/* Konten Galeri */
	.konten-galeri {
		padding-bottom: calc(var(--space-unit) * 12);
	}

	.galeri-kosong {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 16px;
		padding: calc(var(--space-unit) * 12) 0;
		color: var(--neutral-500);
		text-align: center;
	}

	.daftar-kategori {
		display: flex;
		flex-direction: column;
		gap: calc(var(--space-unit) * 10);
	}

	/* Kategori Header */
	.kategori-header {
		display: flex;
		align-items: center;
		gap: 16px;
		margin-bottom: calc(var(--space-unit) * 4);
	}

	.kategori-judul {
		font-family: var(--font-hero), system-ui, sans-serif;
		font-size: 1.5rem;
		font-weight: 800;
		font-style: italic;
		letter-spacing: -0.02em;
		color: var(--neutral-800);
		margin: 0;
	}

	.garis-aksen {
		flex: 1;
		height: 1px;
		background: linear-gradient(90deg, var(--neutral-200) 0%, transparent 100%);
	}

	/* BENTO GRID */
	.bento-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		grid-auto-rows: 200px;
		gap: calc(var(--space-unit) * 2);
	}

	@media (min-width: 768px) {
		.bento-grid {
			grid-template-columns: repeat(4, 1fr);
			grid-auto-rows: 250px;
			gap: calc(var(--space-unit) * 3);
		}
	}

	/* Aturan Pola Bento (Desktop) */
	.bento-item {
		margin: 0;
		border-radius: var(--radius-lg);
		overflow: hidden;
		position: relative;
		transform-style: preserve-3d;
		transition: transform 0.3s ease, box-shadow 0.3s ease;
		box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
		background: var(--white);
	}

	@media (min-width: 768px) {
		.bento-besar {
			grid-column: span 2;
			grid-row: span 2;
		}
		
		.bento-panjang {
			grid-column: span 1;
			grid-row: span 2;
		}

		.bento-lebar {
			grid-column: span 2;
			grid-row: span 1;
		}

		.bento-kecil {
			grid-column: span 1;
			grid-row: span 1;
		}
	}

	/* Elemen Foto & Hover Effect (Liquid Glass) */
	.foto-wrap {
		position: relative;
		width: 100%;
		height: 100%;
		overflow: hidden;
	}

	.bento-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.6s cubic-bezier(0.2, 1, 0.3, 1);
	}

	.bento-item:hover {
		transform: translateY(-4px);
		box-shadow: 0 12px 32px rgba(22, 163, 74, 0.15);
		z-index: 2;
	}

	.bento-item:hover .bento-img {
		transform: scale(1.05);
	}

	.overlay-kaca {
		position: absolute;
		bottom: 0;
		left: 0;
		width: 100%;
		padding: 24px;
		background: linear-gradient(to top, rgba(0, 0, 0, 0.8) 0%, transparent 100%);
		opacity: 0;
		transform: translateY(20px);
		transition: all 0.4s cubic-bezier(0.2, 1, 0.3, 1);
		pointer-events: none;
	}

	/* Efek blur ala Liquid Glass di caption saat di-hover */
	.overlay-kaca::before {
		content: '';
		position: absolute;
		bottom: 12px;
		left: 12px;
		right: 12px;
		top: 12px;
		background: rgba(255, 255, 255, 0.1);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
		border-radius: var(--radius-md);
		border: 1px solid rgba(255, 255, 255, 0.2);
		z-index: -1;
	}

	.caption {
		margin: 0;
		color: var(--white);
		font-size: 0.95rem;
		font-weight: 500;
		text-shadow: 0 2px 4px rgba(0, 0, 0, 0.5);
		/* Menyesuaikan posisi agar masuk di dalam bingkai glass */
		padding: 8px 12px; 
		position: relative;
		z-index: 1;
	}

	.bento-item:hover .overlay-kaca {
		opacity: 1;
		transform: translateY(0);
	}

	@media (prefers-reduced-motion: reduce) {
		.bento-img, .bento-item, .overlay-kaca {
			transition: none !important;
			transform: none !important;
		}
	}
</style>
