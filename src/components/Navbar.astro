---
/**
 * Navbar — Header dengan Dua State Transisi Sesuai Referensi Visual
 *
 * 1. SEBELUM SCROLL (scrollY === 0): Full White Header Bar (Flat/Solid, No Glass, Clean)
 * 2. SETELAH SCROLL (scrollY > 0): Floating Capsule / Pill Navbar (Dark Liquid Glass seperti IMAGE 1)
 * 3. Menu Navigasi berada persis di TENGAH (Center Aligned)
 * 4. Custom logo selalu berlatar belakang putih solid
 * 5. Transisi halus antar kedua state
 */
import { Image } from 'astro:assets';
import { nav } from '../data';

import logoBankSampah from '../assets/images/logo/logobanksampah.png';
import logoKkn from '../assets/images/logo/logokkn.png';
import logoUin from '../assets/images/logo/logouin.webp';

const logoAssets = [logoBankSampah, logoKkn, logoUin];
---

<header class="navbar-wrapper" id="main-navbar" role="banner">
  <nav class="navbar-container" aria-label="Navigasi utama">
    <!-- 1. KIRI: Container Logo (Selalu Putih Solid) -->
    <div class="nav-col nav-col-left">
      <a href="/" class="logo-module" aria-label="Beranda Bank Sampah Bakti Lembur">
        {nav.logo.map((item, i) => (
          <Image
            src={logoAssets[i]}
            alt={item.alt}
            width={item.lebar * 2}
            height={item.tinggi * 2}
            loading="eager"
            decoding="async"
            class="logo-img"
          />
        ))}
      </a>
    </div>

    <!-- 2. TENGAH: Menu Navigasi Desktop (Center Aligned) -->
    <div class="nav-col nav-col-center">
      <ul class="nav-menu-desktop" role="list">
        {nav.tautan.map((item, index) => (
          <li>
            <a
              href={item.href}
              class:list={['nav-item', index === 0 && 'aktif']}
              data-nav-link
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- 3. KANAN: Spacer Penyeimbang Grid Desktop -->
    <div class="nav-col nav-col-right">
    </div>

    <!-- 4. Tombol Hamburger (Mobile) -->
    <button
      class="nav-toggle-btn"
      id="nav-toggle"
      aria-expanded="false"
      aria-controls="nav-drawer"
      aria-label={nav.labelBuka}
      type="button"
    >
      <span class="bar"></span>
      <span class="bar"></span>
      <span class="bar"></span>
    </button>
  </nav>

  <!-- 5. Drawer Menu Mobile -->
  <div id="nav-drawer" class="mobile-drawer" aria-hidden="true" role="dialog" aria-label="Menu navigasi mobile">
    <ul class="mobile-nav-list" role="list">
      {nav.tautan.map((item, index) => (
        <li>
          <a
            href={item.href}
            class:list={['mobile-nav-item', index === 0 && 'aktif']}
            data-mobile-nav-link
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<style>
  /* ════════════════════════════════════════════════════════════════════
     1. WRAPPER & CONTAINER
     ════════════════════════════════════════════════════════════════════ */
  .navbar-wrapper {
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: 100;

    /* KONDISI SEBELUM SCROLL (IMAGE 2): Full White Bar, Flat, Solid */
    background-color: var(--white);
    border-bottom: 1px solid var(--border);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
    padding: calc(var(--space-unit) * 1.5) calc(var(--space-unit) * 2.5);
    pointer-events: auto;

    transition:
      background-color 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      border-bottom-color 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      padding 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @media (min-width: 768px) {
    .navbar-wrapper {
      padding: calc(var(--space-unit) * 1.75) calc(var(--space-unit) * 4);
    }
  }

  /* KONDISI SETELAH SCROLL (IMAGE 1): Wrapper transparan, konten melayang (floating) */
  .navbar-wrapper.is-scrolled {
    background-color: transparent;
    border-bottom-color: transparent;
    box-shadow: none;
    padding: calc(var(--space-unit) * 1.5) calc(var(--space-unit) * 2.5);
    pointer-events: none; /* Klik tembus wrapper, hanya aktif di modul */
  }

  @media (min-width: 768px) {
    .navbar-wrapper.is-scrolled {
      padding: calc(var(--space-unit) * 2) calc(var(--space-unit) * 4);
    }
  }

  /* ─── Grid 3-Kolom untuk Menjamin Menu Berada di Tengah (Center) ─── */
  .navbar-container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: calc(var(--space-unit) * 1.5);
  }

  @media (min-width: 768px) {
    .navbar-container {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
    }
  }

  .nav-col-left {
    display: flex;
    justify-content: flex-start;
  }

  .nav-col-center {
    display: none;
  }

  @media (min-width: 768px) {
    .nav-col-center {
      display: flex;
      justify-content: center;
    }
  }

  .nav-col-right {
    display: none;
  }

  @media (min-width: 768px) {
    .nav-col-right {
      display: flex;
      justify-content: flex-end;
    }
  }

  /* ════════════════════════════════════════════════════════════════════
     2. LOGO MODULE (Menyatu dengan Background sebelum scroll)
     ════════════════════════════════════════════════════════════════════ */
  .logo-module {
    display: inline-flex;
    align-items: center;
    gap: calc(var(--space-unit) * 1.25);
    padding: calc(var(--space-unit) * 0.5) 0;
    text-decoration: none;
    flex-shrink: 0;
    pointer-events: auto;

    /* KONDISI SEBELUM SCROLL: Menyatu murni dengan background putih */
    background: transparent;
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    box-shadow: none;

    transition:
      background-color 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      padding 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.2s ease;
  }

  /* KONDISI SETELAH SCROLL: Menjadi Floating Card Putih Solid */
  .navbar-wrapper.is-scrolled .logo-module {
    background: var(--white);
    border-color: var(--border);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.16);
    padding: calc(var(--space-unit) * 0.75) calc(var(--space-unit) * 1.5);
  }

  .logo-img {
    height: 32px;
    width: auto;
    max-width: 44px;
    object-fit: contain;
    display: block;
    transition: transform 0.2s ease;
  }

  .logo-module:hover .logo-img {
    transform: scale(1.04);
  }

  @media (max-width: 640px) {
    .logo-module {
      padding: calc(var(--space-unit) * 0.5) calc(var(--space-unit) * 1.25);
      gap: calc(var(--space-unit) * 0.75);
    }
    .logo-img {
      height: 26px;
    }
  }

  /* ════════════════════════════════════════════════════════════════════
     3. MENU NAVIGASI DESKTOP (Center Aligned)
     ════════════════════════════════════════════════════════════════════ */
  .nav-menu-desktop {
    list-style: none;
    margin: 0;
    display: flex;
    align-items: center;
    gap: calc(var(--space-unit) * 0.5);
    border-radius: var(--radius-md);
    pointer-events: auto;

    /* KONDISI SEBELUM SCROLL (IMAGE 2): Flat, menyatu dengan bar putih */
    background: transparent;
    border: 1px solid transparent;
    box-shadow: none;
    padding: calc(var(--space-unit) * 0.5) calc(var(--space-unit) * 0.75);

    transition:
      background-color 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      backdrop-filter 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      -webkit-backdrop-filter 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nav-item {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 calc(var(--space-unit) * 1.5);
    font-family: var(--font-isi), system-ui, sans-serif;
    font-size: var(--text-kecil);
    font-weight: 500;
    letter-spacing: 0.015em;
    text-decoration: none;
    border-radius: var(--radius-sm);
    white-space: nowrap;
    border: 1px solid transparent;

    /* KONDISI SEBELUM SCROLL: Teks gelap kontras tinggi */
    color: var(--neutral-700);

    transition:
      color 0.2s ease,
      background-color 0.2s ease,
      border-color 0.2s ease;
  }

  .nav-item:hover {
    color: var(--neutral-900);
    background-color: var(--neutral-100);
  }

  .nav-item.aktif {
    color: var(--neutral-900);
    font-weight: 600;
    background-color: transparent;
    border-color: transparent;
  }

  /* ─── KONDISI SETELAH SCROLL (IMAGE 1): Liquid Glass Capsule Gelap ─── */
  .navbar-wrapper.is-scrolled .nav-menu-desktop {
    background: rgba(18, 24, 18, 0.55);
    border-color: rgba(255, 255, 255, 0.35);
    box-shadow:
      0 12px 40px rgba(0, 0, 0, 0.3),
      inset 0 1px 0 rgba(255, 255, 255, 0.4),
      inset 0 -1px 0 rgba(0, 0, 0, 0.2);
  }

  @supports (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)) {
    .navbar-wrapper.is-scrolled .nav-menu-desktop {
      -webkit-backdrop-filter: blur(24px) saturate(180%);
      backdrop-filter: blur(24px) saturate(180%);
    }
  }

  .navbar-wrapper.is-scrolled .nav-item {
    color: rgba(255, 255, 255, 0.88);
  }

  .navbar-wrapper.is-scrolled .nav-item:hover {
    color: var(--white);
    background-color: rgba(255, 255, 255, 0.12);
  }

  .navbar-wrapper.is-scrolled .nav-item.aktif {
    color: var(--white);
    background-color: transparent;
    border-color: transparent;
    box-shadow: none;
    text-shadow: 0 0 12px rgba(255, 255, 255, 0.5); /* Glow halus menyatu dengan kaca */
  }

  /* ════════════════════════════════════════════════════════════════════
     4. TOMBOL CTA DESKTOP (Kanan)
     ════════════════════════════════════════════════════════════════════ */
  .nav-cta-btn {
    display: inline-flex;
    align-items: center;
    min-height: 42px;
    padding: 0 calc(var(--space-unit) * 2);
    font-family: var(--font-isi), system-ui, sans-serif;
    font-size: var(--text-kecil);
    font-weight: 600;
    text-decoration: none;
    border-radius: var(--radius-md);
    pointer-events: auto;

    /* Sebelum scroll: Solid Brand Green */
    background: var(--brand-green);
    color: var(--white);
    border: 1px solid var(--brand-green-dark);
    box-shadow: 0 2px 8px rgba(62, 116, 53, 0.25);

    transition:
      background-color 0.35s ease,
      border-color 0.35s ease,
      box-shadow 0.35s ease,
      transform 0.15s ease;
  }

  .nav-cta-btn:hover {
    background: var(--brand-green-dark);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(62, 116, 53, 0.35);
  }

  /* Setelah scroll: Floating Pill Green */
  .navbar-wrapper.is-scrolled .nav-cta-btn {
    background: rgba(62, 116, 53, 0.88);
    border-color: rgba(255, 255, 255, 0.3);
    box-shadow:
      0 8px 24px rgba(0, 0, 0, 0.25),
      inset 0 1px 1px rgba(255, 255, 255, 0.4);
  }

  @supports (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)) {
    .navbar-wrapper.is-scrolled .nav-cta-btn {
      -webkit-backdrop-filter: blur(16px);
      backdrop-filter: blur(16px);
    }
  }

  /* ════════════════════════════════════════════════════════════════════
     5. HAMBURGER & MOBILE DRAWER
     ════════════════════════════════════════════════════════════════════ */
  .nav-toggle-btn {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    padding: 0;
    cursor: pointer;
    border-radius: var(--radius-md);
    pointer-events: auto;

    /* Sebelum scroll: Menyatu flat dengan header putih */
    background: transparent;
    border: 1px solid transparent;
    box-shadow: none;

    transition:
      background-color 0.35s ease,
      border-color 0.35s ease,
      box-shadow 0.35s ease;
  }

  @media (min-width: 768px) {
    .nav-toggle-btn {
      display: none;
    }
  }

  .bar {
    display: block;
    width: 20px;
    height: 2px;
    border-radius: 2px;
    background: var(--neutral-900);
    transition:
      transform 0.25s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.2s ease,
      background-color 0.35s ease;
  }

  /* Hamburger saat scroll: Liquid Glass */
  .navbar-wrapper.is-scrolled .nav-toggle-btn {
    background: rgba(18, 24, 18, 0.72);
    border-color: rgba(255, 255, 255, 0.28);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
  }

  @supports (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)) {
    .navbar-wrapper.is-scrolled .nav-toggle-btn {
      -webkit-backdrop-filter: blur(16px);
      backdrop-filter: blur(16px);
    }
  }

  .navbar-wrapper.is-scrolled .bar {
    background: var(--white);
  }

  .nav-toggle-btn[aria-expanded='true'] .bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .nav-toggle-btn[aria-expanded='true'] .bar:nth-child(2) {
    opacity: 0;
  }
  .nav-toggle-btn[aria-expanded='true'] .bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* ─── Mobile Drawer ─────────────────────────────────────────────── */
  .mobile-drawer {
    pointer-events: auto;
    margin-top: calc(var(--space-unit) * 1.25);
    border-radius: var(--radius-md);
    background: var(--white);
    border: 1px solid var(--border);
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.14);
    overflow: hidden;
    max-height: 0;
    opacity: 0;
    transition:
      max-height 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.25s ease,
      background-color 0.35s ease,
      border-color 0.35s ease;
  }

  .mobile-drawer[aria-hidden='false'] {
    max-height: 480px;
    opacity: 1;
  }

  @media (min-width: 768px) {
    .mobile-drawer {
      display: none;
    }
  }

  .mobile-nav-list {
    list-style: none;
    margin: 0;
    padding: calc(var(--space-unit) * 1) 0;
    display: flex;
    flex-direction: column;
  }

  .mobile-nav-item {
    display: block;
    padding: calc(var(--space-unit) * 1.5) calc(var(--space-unit) * 2.5);
    font-family: var(--font-isi), system-ui, sans-serif;
    font-size: var(--text-isi);
    font-weight: 500;
    color: var(--neutral-700);
    text-decoration: none;
    border-left: 3px solid transparent;
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }

  .mobile-nav-item:hover {
    color: var(--neutral-900);
    background-color: var(--neutral-100);
  }

  .mobile-nav-item.aktif {
    color: var(--neutral-900);
    font-weight: 600;
    background-color: transparent;
    border-left-color: transparent;
  }

  /* Drawer saat scroll */
  .navbar-wrapper.is-scrolled .mobile-drawer {
    background: rgba(18, 24, 18, 0.65);
    border-color: rgba(255, 255, 255, 0.22);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.35);
  }

  @supports (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)) {
    .navbar-wrapper.is-scrolled .mobile-drawer {
      -webkit-backdrop-filter: blur(24px) saturate(180%);
      backdrop-filter: blur(24px) saturate(180%);
    }
  }

  .navbar-wrapper.is-scrolled .mobile-nav-item {
    color: rgba(255, 255, 255, 0.88);
  }

  .navbar-wrapper.is-scrolled .mobile-nav-item:hover {
    color: var(--white);
    background-color: rgba(255, 255, 255, 0.1);
  }

  .navbar-wrapper.is-scrolled .mobile-nav-item.aktif {
    color: var(--white);
    background-color: transparent;
    border-left-color: transparent;
    text-shadow: 0 0 12px rgba(255, 255, 255, 0.5);
  }

  /* ════════════════════════════════════════════════════════════════════
     6. AKSESIBILITAS
     ════════════════════════════════════════════════════════════════════ */
  @media (prefers-reduced-transparency: reduce) {
    .nav-menu-desktop,
    .mobile-drawer,
    .nav-toggle-btn,
    .nav-cta-btn {
      -webkit-backdrop-filter: none !important;
      backdrop-filter: none !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .navbar-wrapper,
    .nav-menu-desktop,
    .nav-item,
    .bar,
    .mobile-drawer,
    .mobile-nav-item,
    .logo-img,
    .nav-cta-btn,
    .logo-module {
      transition: none !important;
    }
  }
</style>

<script>
  /**
   * 1. Deteksi scroll posisi (scrollY > 20) untuk mengaktifkan class .is-scrolled
   * 2. Scrollspy: Menandai menu aktif sesuai seksi di viewport
   * 3. Toggle Drawer Mobile & Aksesibilitas Keyboard (Esc)
   */
  const navbar = document.getElementById('main-navbar');
  const toggle = document.getElementById('nav-toggle') as HTMLButtonElement | null;
  const drawer = document.getElementById('nav-drawer') as HTMLElement | null;
  const desktopLinks = document.querySelectorAll('[data-nav-link]') as NodeListOf<HTMLAnchorElement>;
  const mobileLinks = document.querySelectorAll('[data-mobile-nav-link]') as NodeListOf<HTMLAnchorElement>;

  // Deteksi Scroll
  const handleScroll = () => {
    if (navbar) {
      navbar.classList.toggle('is-scrolled', window.scrollY > 20);
    }
  };

  window.addEventListener('scroll', handleScroll, { passive: true });
  handleScroll();

  // Mobile Drawer Toggle
  if (toggle && drawer) {
    toggle.addEventListener('click', () => {
      const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', isExpanded ? 'false' : 'true');
      drawer.setAttribute('aria-hidden', isExpanded ? 'true' : 'false');
    });

    drawer.querySelectorAll('a').forEach((a) => {
      a.addEventListener('click', () => {
        toggle.setAttribute('aria-expanded', 'false');
        drawer.setAttribute('aria-hidden', 'true');
      });
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        toggle.setAttribute('aria-expanded', 'false');
        drawer.setAttribute('aria-hidden', 'true');
        toggle.focus();
      }
    });
  }

  // Scrollspy menggunakan IntersectionObserver
  const sections = Array.from(desktopLinks)
    .map((link) => {
      const href = link.getAttribute('href');
      if (href && href.startsWith('#') && href.length > 1) {
        return document.querySelector(href);
      }
      return null;
    })
    .filter(Boolean) as HTMLElement[];

  const setActiveLink = (targetId: string | null) => {
    desktopLinks.forEach((link) => {
      const href = link.getAttribute('href');
      const isTarget = targetId ? href === `#${targetId}` : href === '/';
      link.classList.toggle('aktif', isTarget);
      if (isTarget) link.setAttribute('aria-current', 'page');
      else link.removeAttribute('aria-current');
    });

    mobileLinks.forEach((link) => {
      const href = link.getAttribute('href');
      const isTarget = targetId ? href === `#${targetId}` : href === '/';
      link.classList.toggle('aktif', isTarget);
      if (isTarget) link.setAttribute('aria-current', 'page');
      else link.removeAttribute('aria-current');
    });
  };

  if ('IntersectionObserver' in window && sections.length > 0) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            setActiveLink(entry.target.id);
          }
        });
        if (window.scrollY < 100) {
          setActiveLink(null); // Beranda
        }
      },
      { rootMargin: '-20% 0px -70% 0px', threshold: 0 }
    );

    sections.forEach((sec) => observer.observe(sec));
  }
</script>
