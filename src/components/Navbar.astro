---
/**
 * Navbar — Header dengan Dua State Transisi Sesuai Referensi Visual
 *
 * 1. SEBELUM SCROLL (scrollY === 0): Full White Header Bar (Flat/Solid, No Glass, Clean)
 * 2. SETELAH SCROLL (scrollY > 0): Floating Capsule / Pill Navbar (Dark Liquid Glass seperti IMAGE 1)
 * 3. Menu Navigasi berada persis di TENGAH (Center Aligned)
 * 4. Custom logo selalu berlatar belakang putih solid
 * 5. Transisi halus antar kedua state
 */
import { Image } from "astro:assets";
import { nav } from "../data";

import logoBankSampah from "../assets/images/logo/logobanksampah.png";
import logoKkn from "../assets/images/logo/logokkn.png";
import logoUin from "../assets/images/logo/logouin.webp";

const logoAssets = [logoBankSampah, logoKkn, logoUin];
---

<header class="navbar-wrapper" id="main-navbar" role="banner">
  <nav class="navbar-container" aria-label="Navigasi utama">
    <!-- 1. KIRI: Container Logo (Selalu Putih Solid) -->
    <div class="nav-col nav-col-left">
      <a
        href="/"
        class="logo-module"
        aria-label="Beranda Bank Sampah Bakti Lembur"
      >
        {
          nav.logo.map((item, i) => (
            <Image
              src={logoAssets[i]}
              alt={item.alt}
              width={item.lebar * 2}
              height={item.tinggi * 2}
              loading="eager"
              decoding="async"
              class:list={["logo-img", i !== 2 && "logo-putih"]}
            />
          ))
        }
      </a>
    </div>

    <!-- 2. TENGAH: Menu Navigasi Desktop (Center Aligned) -->
    <div class="nav-col nav-col-center">
      <ul class="nav-menu-desktop" role="list">
        {
          nav.tautan.map((item, index) => (
            <li>
              <a
                href={item.href}
                class:list={["nav-item", index === 0 && "aktif"]}
                data-nav-link
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- 3. KANAN: Spacer Penyeimbang Grid Desktop -->
    <div class="nav-col nav-col-right"></div>

    <!-- 4. Tombol Hamburger (Mobile) -->
    <button
      class="nav-toggle-btn"
      id="nav-toggle"
      aria-expanded="false"
      aria-controls="nav-drawer"
      aria-label={nav.labelBuka}
      type="button"
    >
      <span class="bar"></span>
      <span class="bar"></span>
      <span class="bar"></span>
    </button>
  </nav>

  <!-- 5. Drawer Menu Mobile -->
  <div
    id="nav-drawer"
    class="mobile-drawer"
    aria-hidden="true"
    role="dialog"
    aria-label="Menu navigasi mobile"
  >
    <ul class="mobile-nav-list" role="list">
      {
        nav.tautan.map((item, index) => (
          <li>
            <a
              href={item.href}
              class:list={["mobile-nav-item", index === 0 && "aktif"]}
              data-mobile-nav-link
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<style>
  /* ════════════════════════════════════════════════════════════════════
     1. WRAPPER & CONTAINER
     ════════════════════════════════════════════════════════════════════ */
  .navbar-wrapper {
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: 100;

    /* KONDISI SEBELUM SCROLL: Transparan */
    background-color: transparent;
    border-bottom: 1px solid transparent;
    box-shadow: none;
    padding: calc(var(--space-unit) * 1.5) calc(var(--space-unit) * 2.5);
    pointer-events: none;

    transition:
      background-color 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      border-bottom-color 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      padding 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @media (min-width: 768px) {
    .navbar-wrapper {
      padding: calc(var(--space-unit) * 2) calc(var(--space-unit) * 4);
    }
  }

  /* KONDISI SETELAH SCROLL: Solid White Bar */
  .navbar-wrapper.is-scrolled {
    background-color: var(--white);
    border-bottom-color: var(--border);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
    padding: calc(var(--space-unit) * 1.5) calc(var(--space-unit) * 2.5);
    pointer-events: auto; 
  }

  @media (min-width: 768px) {
    .navbar-wrapper.is-scrolled {
      padding: calc(var(--space-unit) * 1.75) calc(var(--space-unit) * 4);
    }
  }

  .navbar-container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: calc(var(--space-unit) * 1.5);
    pointer-events: auto; /* Pastikan interaksi klik berfungsi */
  }

  @media (min-width: 768px) {
    .navbar-container {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
    }
  }

  .nav-col-left {
    display: flex;
    justify-content: flex-start;
  }
  .nav-col-center {
    display: none;
  }
  @media (min-width: 768px) {
    .nav-col-center {
      display: flex;
      justify-content: center;
    }
  }
  .nav-col-right {
    display: none;
  }
  @media (min-width: 768px) {
    .nav-col-right {
      display: flex;
      justify-content: flex-end;
    }
  }

  /* ════════════════════════════════════════════════════════════════════
     2. LOGO MODULE
     ════════════════════════════════════════════════════════════════════ */
  .logo-module {
    display: inline-flex;
    align-items: center;
    gap: calc(var(--space-unit) * 1.25);
    padding: calc(var(--space-unit) * 0.5) 0;
    text-decoration: none;
    flex-shrink: 0;
    background: transparent;
    transition: transform 0.2s ease;
  }

  .logo-img {
    height: 34px;
    width: auto;
    max-width: 140px;
    object-fit: contain;
    display: block;
    transition: transform 0.2s ease, filter 0.3s ease;
  }

  /* Perkecil sedikit logo Bank Sampah agar seimbang dengan logo bundar KKN & UIN */
  .logo-module .logo-img:first-child {
    height: 27px;
  }

  /* Ubah logo tertentu menjadi putih polos saat navbar transparan */
  .logo-putih {
    filter: brightness(0) invert(1);
  }

  .logo-module:hover .logo-img {
    transform: scale(1.04);
  }

  /* Kembalikan warna asli logo saat navbar menjadi putih */
  .navbar-wrapper.is-scrolled .logo-putih {
    filter: none;
  }

  @media (max-width: 640px) {
    .logo-module {
      gap: calc(var(--space-unit) * 0.75);
    }
    .logo-img {
      height: 26px;
    }
    .logo-module .logo-img:first-child {
      height: 21px;
    }
  }

  /* ════════════════════════════════════════════════════════════════════
     3. MENU NAVIGASI DESKTOP
     ════════════════════════════════════════════════════════════════════ */
  .nav-menu-desktop {
    list-style: none;
    margin: 0;
    display: flex;
    align-items: center;
    gap: calc(var(--space-unit) * 0.5);
    background: transparent;
    padding: calc(var(--space-unit) * 0.5) calc(var(--space-unit) * 0.75);
  }

  .nav-item {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 calc(var(--space-unit) * 1.5);
    font-family: var(--font-isi), system-ui, sans-serif;
    font-size: var(--text-kecil);
    font-weight: 500;
    letter-spacing: 0.015em;
    text-decoration: none;
    border-radius: var(--radius-sm);
    white-space: nowrap;
    background-color: transparent;

    /* SEBELUM SCROLL: Teks Putih Terang, Tanpa Hover/Aktif Efek */
    color: #FFFFFF;
    text-shadow: 0 1px 4px rgba(0,0,0,0.4); /* Opsional agar lebih terbaca di background terang */
    transition: color 0.2s ease, text-decoration-color 0.2s ease;
  }

  /* Memastikan tetap putih dan polos sebelum di-scroll */
  .nav-item:hover,
  .nav-item.aktif {
    color: #FFFFFF;
    text-decoration: none;
  }

  /* SETELAH SCROLL: Teks Gelap, Ada Hover Hijau, Ada Garis Bawah Aktif */
  .navbar-wrapper.is-scrolled .nav-item {
    color: var(--neutral-700);
    text-shadow: none;
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
    text-decoration-color: transparent;
  }
  .navbar-wrapper.is-scrolled .nav-item:hover {
    color: var(--brand-green);
  }
  .navbar-wrapper.is-scrolled .nav-item.aktif {
    color: var(--brand-green);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--brand-green);
  }

  /* SETELAH SCROLL: Teks Gelap */
  .navbar-wrapper.is-scrolled .nav-item {
    color: var(--neutral-700);
  }
  .navbar-wrapper.is-scrolled .nav-item:hover {
    color: var(--brand-green);
  }
  .navbar-wrapper.is-scrolled .nav-item.aktif {
    color: var(--brand-green);
  }

  /* ════════════════════════════════════════════════════════════════════
     4. TOMBOL CTA DESKTOP (Kanan)
     ════════════════════════════════════════════════════════════════════ */
  .nav-cta-btn {
    display: inline-flex;
    align-items: center;
    min-height: 42px;
    padding: 0 calc(var(--space-unit) * 2);
    font-family: var(--font-isi), system-ui, sans-serif;
    font-size: var(--text-kecil);
    font-weight: 600;
    text-decoration: none;
    border-radius: var(--radius-md);

    background: var(--brand-green);
    color: var(--white);
    border: 1px solid var(--brand-green-dark);
    box-shadow: 0 2px 8px rgba(62, 116, 53, 0.25);
    transition: background-color 0.35s ease, transform 0.15s ease, box-shadow 0.35s ease;
  }

  .nav-cta-btn:hover {
    background: var(--brand-green-dark);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(62, 116, 53, 0.35);
  }

  /* ════════════════════════════════════════════════════════════════════
     5. HAMBURGER & MOBILE DRAWER
     ════════════════════════════════════════════════════════════════════ */
  .nav-toggle-btn {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    padding: 0;
    cursor: pointer;
    background: transparent;
    border: none;
  }

  @media (min-width: 768px) {
    .nav-toggle-btn {
      display: none;
    }
  }

  .bar {
    display: block;
    width: 20px;
    height: 2px;
    border-radius: 2px;
    background: var(--white); /* Sebelum scroll: Putih */
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.2s ease, background-color 0.35s ease;
  }

  .navbar-wrapper.is-scrolled .bar {
    background: var(--neutral-900); /* Sesudah scroll: Gelap */
  }

  .nav-toggle-btn[aria-expanded="true"] .bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .nav-toggle-btn[aria-expanded="true"] .bar:nth-child(2) {
    opacity: 0;
  }
  .nav-toggle-btn[aria-expanded="true"] .bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Mobile Drawer (Selalu Solid Putih agar tulisan terbaca saat dibuka) */
  .mobile-drawer {
    pointer-events: auto;
    margin-top: calc(var(--space-unit) * 1.25);
    border-radius: var(--radius-md);
    background: var(--white);
    border: 1px solid var(--border);
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.14);
    overflow: hidden;
    max-height: 0;
    opacity: 0;
    transition: max-height 0.35s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.25s ease;
  }

  .mobile-drawer[aria-hidden="false"] {
    max-height: 480px;
    opacity: 1;
  }

  @media (min-width: 768px) {
    .mobile-drawer {
      display: none;
    }
  }

  .mobile-nav-list {
    list-style: none;
    margin: 0;
    padding: calc(var(--space-unit) * 1) 0;
    display: flex;
    flex-direction: column;
  }

  .mobile-nav-item {
    display: block;
    padding: calc(var(--space-unit) * 1.5) calc(var(--space-unit) * 2.5);
    font-family: var(--font-isi), system-ui, sans-serif;
    font-size: var(--text-isi);
    font-weight: 500;
    color: var(--neutral-700);
    text-decoration: none;
    border-left: 3px solid transparent;
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }

  .mobile-nav-item:hover {
    color: var(--neutral-900);
    background-color: var(--neutral-100);
  }

  .mobile-nav-item.aktif {
    color: var(--brand-green);
    font-weight: 600;
    background-color: rgba(62, 116, 53, 0.05);
    border-left-color: var(--brand-green);
  }
</style>

<script>
  const navbar = document.getElementById("main-navbar");
  const toggle = document.getElementById("nav-toggle") as HTMLButtonElement | null;
  const drawer = document.getElementById("nav-drawer") as HTMLElement | null;
  const desktopLinks = document.querySelectorAll("[data-nav-link]") as NodeListOf<HTMLAnchorElement>;
  const mobileLinks = document.querySelectorAll("[data-mobile-nav-link]") as NodeListOf<HTMLAnchorElement>;

  // Deteksi Scroll: Mengaktifkan mode solid white
  const handleScroll = () => {
    if (navbar) {
      navbar.classList.toggle("is-scrolled", window.scrollY > 20);
    }
  };

  window.addEventListener("scroll", handleScroll, { passive: true });
  handleScroll();

  // Mobile Drawer Toggle
  if (toggle && drawer) {
    toggle.addEventListener("click", () => {
      const isExpanded = toggle.getAttribute("aria-expanded") === "true";
      toggle.setAttribute("aria-expanded", isExpanded ? "false" : "true");
      drawer.setAttribute("aria-hidden", isExpanded ? "true" : "false");
    });

    drawer.querySelectorAll("a").forEach((a) => {
      a.addEventListener("click", () => {
        toggle.setAttribute("aria-expanded", "false");
        drawer.setAttribute("aria-hidden", "true");
      });
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") {
        toggle.setAttribute("aria-expanded", "false");
        drawer.setAttribute("aria-hidden", "true");
        toggle.focus();
      }
    });
  }

  // Scrollspy menggunakan IntersectionObserver
  const sections = Array.from(desktopLinks)
    .map((link) => {
      const href = link.getAttribute("href");
      if (href && href.startsWith("#") && href.length > 1) {
        return document.querySelector(href);
      }
      return null;
    })
    .filter(Boolean) as HTMLElement[];

  const setActiveLink = (targetId: string | null) => {
    desktopLinks.forEach((link) => {
      const href = link.getAttribute("href");
      const isTarget = targetId ? href === `#${targetId}` : href === "/";
      link.classList.toggle("aktif", isTarget);
      if (isTarget) link.setAttribute("aria-current", "page");
      else link.removeAttribute("aria-current");
    });

    mobileLinks.forEach((link) => {
      const href = link.getAttribute("href");
      const isTarget = targetId ? href === `#${targetId}` : href === "/";
      link.classList.toggle("aktif", isTarget);
      if (isTarget) link.setAttribute("aria-current", "page");
      else link.removeAttribute("aria-current");
    });
  };

  if ("IntersectionObserver" in window && sections.length > 0) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            setActiveLink(entry.target.id);
          }
        });
        if (window.scrollY < 100) {
          setActiveLink(null);
        }
      },
      { rootMargin: "-20% 0px -70% 0px", threshold: 0 },
    );

    sections.forEach((sec) => observer.observe(sec));
  }
</script>
