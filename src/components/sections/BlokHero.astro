---
/**
 * BlokHero — Hero Section dengan Foto Latar Berganti Otomatis
 *
 * Menampilkan foto latar dengan transisi crossfade tanpa video autoplay.
 * Hero hanya memiliki satu slide dengan konten teks dan CTA.
 */
import { Image } from "astro:assets";
import { beranda, ctaWhatsapp } from "../../data";

import heroBg from "../../assets/images/background/imagebg.jpg";
import heroBg2 from "../../assets/images/latarbelakang/IMG_8919.JPG";

const { s1 } = beranda;
const ctaNasabah = ctaWhatsapp("nasabah");
---

<div class="hero-blok" id="hero-slider-blok">
	<!-- ════ FOTO LATAR BERSAMA (UNTUK KEDUA SLIDE) DENGAN ANIMASI CROSSFADE ════ -->
	<div class="hero-latar" aria-hidden="true">
		<!-- Latar 1 (Utama) -->
		<Image
			src={heroBg}
			alt="Kegiatan tim KKN dan warga di Bank Sampah Bakti Lembur"
			widths={[640, 960, 1280, 1920]}
			sizes="100vw"
			loading="eager"
			fetchpriority="high"
			decoding="sync"
			class="hero-foto"
		/>
		<!-- Latar 2 (Baru) dengan animasi fade -->
		<Image
			src={heroBg2}
			alt="Kegiatan warga menyetorkan sampah"
			widths={[640, 960, 1280, 1920]}
			sizes="100vw"
			loading="eager"
			fetchpriority="high"
			decoding="sync"
			class="hero-foto foto-fade"
		/>
		<div class="hero-scrim"></div>
	</div>

	<!-- ════ SLIDE 1: FOTO UTAMA & TEKS ════ -->
	<div class="hero-slide slide-1 is-active" id="hero-slide-1">
		<div class="hero-konten">
			<h1 class="hero-judul">
				{s1.judul.awal}
				<span class="stabilo-hijau">{s1.judul.sorot}</span>
			</h1>

			<p class="hero-subjudul">
				{s1.subjudul.awal}
				<span class="stabilo-emas">{s1.subjudul.sorot}</span>
			</p>

			<div class="hero-tombol">
				<!-- CTA Utama: WhatsApp -->
				<a
					href={ctaNasabah.url}
					target="_blank"
					rel="noopener noreferrer"
					data-cta
					data-ga4={ctaNasabah.eventGa4}
					class="btn btn-hijau"
				>
					{ctaNasabah.label}
				</a>

				<!-- CTA Sekunder: Anchor link alur -->
				<a href={s1.ctaSekunder.anchor} class="btn btn-outline">
					{s1.ctaSekunder.label}
				</a>
			</div>
		</div>
	</div>
</div>

<script>
	// Slide 1 hanya menampilkan foto tanpa video autoplay
	// Tidak ada auto-slide ke video
</script>

<style>
	/* ─── Wrapper Full-Screen ────────────────────────────────────────── */
	.hero-blok {
		position: relative;
		isolation: isolate;
		min-height: 100svh;
		width: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
		background: #0b0f0b;
	}

	/* ─── Foto Latar Bersama ─────────────────────────────────────────── */
	.hero-latar {
		position: absolute;
		inset: 0;
		z-index: 0;
	}

	.hero-foto {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center top;
	}

	/* Animasi Crossfade Background tanpa JS */
	.foto-fade {
		opacity: 0;
		animation: crossfadeBg 16s infinite;
	}

	@keyframes crossfadeBg {
		0%,
		45% {
			opacity: 0;
		} /* Foto 1 Tampil */
		50%,
		95% {
			opacity: 1;
		} /* Foto 2 Tampil (IMG_8919) */
		100% {
			opacity: 0;
		}
	}

	.hero-scrim {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			180deg,
			rgba(14, 20, 14, 0.62) 0%,
			rgba(14, 20, 14, 0.68) 50%,
			rgba(14, 20, 14, 0.78) 100%
		);
	}

	/* ─── Slide Container ────────────────────────────────────────────── */
	.hero-slide {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
		transition:
			opacity 0.7s cubic-bezier(0.4, 0, 0.2, 1),
			visibility 0.7s ease;
		display: flex;
		align-items: center;
		justify-content: center;
		z-index: 1;
	}

	.hero-slide.is-active {
		opacity: 1;
		visibility: visible;
		pointer-events: auto;
		z-index: 2;
	}

	/* ─── Slide 1: Konten Teks Tengah ────────────────────────────────── */
	.hero-konten {
		position: relative;
		width: 100%;
		max-width: 900px;
		padding: calc(var(--space-unit) * 14) calc(var(--space-unit) * 3)
			calc(var(--space-unit) * 8);
		margin: 0 auto;
		text-align: center;
		color: var(--white);
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: calc(var(--space-unit) * 3);
	}

	/* ─── Judul ──────────────────────────────────── */
	.hero-judul {
		margin: 0;
		font-family: var(--font-isi), system-ui, sans-serif;
		font-size: clamp(1.75rem, 5.2vw, 3.75rem);
		font-weight: 600;
		line-height: 1.22;
		letter-spacing: -0.02em;
		color: var(--white);
		text-shadow: 0 4px 32px rgba(0, 0, 0, 0.5);
		text-wrap: balance;
		max-width: 900px;
	}

	/* Efek Stabilo Hijau Muda pada Judul (Selalu 1 Baris Utuh di Tengah Sesuai Gambar Referensi) */
	.stabilo-hijau {
		display: block;
		width: fit-content;
		margin: 0.18em auto 0;
		position: relative;
		white-space: nowrap;
		z-index: 1;
	}

	.stabilo-hijau::before {
		content: "";
		position: absolute;
		left: -6px;
		right: -6px;
		bottom: 8%;
		height: 38%;
		background: rgba(144, 238, 144, 0.72); /* Light green stabilo */
		z-index: -1;
		border-radius: 4px;
		transform: rotate(-1.2deg);
	}

	/* Efek Stabilo Emas pada Subjudul */
	.stabilo-emas {
		position: relative;
		display: inline-block;
		white-space: nowrap;
		z-index: 1;
	}

	.stabilo-emas::before {
		content: "";
		position: absolute;
		left: -3px;
		right: -5px;
		bottom: 10%;
		height: 40%;
		background: rgba(245, 158, 11, 0.6); /* Amber / Emas stabilo */
		z-index: -1;
		border-radius: 3px;
		transform: rotate(0.8deg);
	}

	@media (max-width: 480px) {
		.hero-judul {
			font-size: clamp(1.35rem, 6.2vw, 1.85rem);
			line-height: 1.25;
		}

		.stabilo-hijau::before {
			height: 40%;
			bottom: 6%;
		}
	}

	/* ─── Subjudul ───────────────────────────────────────────────────── */
	.hero-subjudul {
		margin: 0;
		font-family: var(--font-isi), system-ui, sans-serif;
		font-size: clamp(0.9375rem, 2vw, 1.15rem);
		font-weight: 500;
		line-height: 1.6;
		color: rgba(255, 255, 255, 0.95);
		max-width: 680px;
		text-shadow: 0 2px 16px rgba(0, 0, 0, 0.5);
		text-wrap: balance;
	}

	/* ─── Tombol CTA (Hanya 2 Tombol: WA & Alur) ─────────────────────── */
	.hero-tombol {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: calc(var(--space-unit) * 1.5);
		flex-wrap: wrap;
		margin-top: calc(var(--space-unit) * 1);
	}

	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: calc(var(--space-unit) * 1);
		min-height: 48px;
		padding: calc(var(--space-unit) * 1.5) calc(var(--space-unit) * 3.5);
		border-radius: 999px;
		font-family: var(--font-isi), system-ui, sans-serif;
		font-size: var(--text-isi);
		font-weight: 600;
		text-decoration: none;
		cursor: pointer;
		transition:
			transform 0.15s ease,
			box-shadow 0.2s ease,
			background-color 0.2s ease;
	}

	/* Tombol Hijau Solid */
	.btn-hijau {
		background: var(--brand-green);
		color: var(--white);
		border: 1px solid var(--brand-green);
		box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
	}

	.btn-hijau:hover {
		background: var(--brand-green-dark);
		border-color: var(--brand-green-dark);
		transform: translateY(-2px);
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
	}

	/* Tombol Outline Kaca */
	.btn-outline {
		background: rgba(18, 24, 18, 0.35);
		color: var(--white);
		border: 1.5px solid rgba(255, 255, 255, 0.85);
		box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
	}

	@supports (backdrop-filter: blur(1px)) or
		(-webkit-backdrop-filter: blur(1px)) {
		.btn-outline {
			-webkit-backdrop-filter: blur(10px);
			backdrop-filter: blur(10px);
		}
	}

	.btn-outline:hover {
		background: rgba(255, 255, 255, 0.18);
		border-color: var(--white);
		transform: translateY(-2px);
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
	}

	/* ─── Slide 2: Dihapus (Tidak ada video autoplay di hero) ──────────── */

	/* ─── Desktop ──────────────────────────────────────────────────────── */
	@media (min-width: 768px) {
		.hero-konten {
			padding: calc(var(--space-unit) * 18) calc(var(--space-unit) * 6)
				calc(var(--space-unit) * 12);
		}
	}

	/* ─── Aksesibilitas ────────────────────────────────────────────────── */
	@media (prefers-reduced-transparency: reduce) {
		.btn-outline,
		.btn-tutup-video-slide,
		.video-card-frame {
			background: var(--neutral-900);
			-webkit-backdrop-filter: none;
			backdrop-filter: none;
		}

		.hero-scrim {
			background: rgba(14, 20, 14, 0.75);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-slide {
			transition: none;
		}
		.btn,
		.btn-tutup-video-slide {
			transition: none;
		}
	}
</style>
