---
/**
 * BlokHero — Hero Section dengan Auto-Slide Berdurasi
 *
 * Slide 1: Foto Latar Utama + Headline & 2 Tombol CTA.
 * Slide 2: Video Profil YouTube dengan Tombol Close Permanen.
 * Jika tombol Close diklik, hero kembali ke Slide 1 dan auto-slide dinonaktifkan
 * hingga halaman di-refresh.
 */
import { Image } from "astro:assets";
import { beranda, ctaWhatsapp, profil } from "../../data";
import Ikon from "../ui/Ikon.astro";

import heroBg from "../../assets/images/background/imagebg.jpg";
import heroBg2 from "../../assets/images/latarbelakang/IMG_8919.JPG";

const { s1 } = beranda;
const ctaNasabah = ctaWhatsapp("nasabah");
const youtubeId = profil.video.idYoutube;
const youtubeJudul = profil.video.judul;
---

<div
	class="hero-blok di-atas-foto"
	id="hero-slider-blok"
	data-videoid={youtubeId}
	data-videojudul={youtubeJudul}
>
	<!-- ════ FOTO LATAR BERSAMA (UNTUK KEDUA SLIDE) DENGAN ANIMASI CROSSFADE ════ -->
	<div class="hero-latar" aria-hidden="true">
		<!-- Latar 1 (Utama) -->
		<Image
			src={heroBg}
			alt="Kegiatan tim KKN dan warga di Bank Sampah Bakti Lembur"
			widths={[640, 960, 1280, 1920]}
			sizes="100vw"
			loading="eager"
			fetchpriority="high"
			decoding="sync"
			class="hero-foto"
		/>
		<!-- Latar 2 (Baru) dengan animasi fade -->
		<Image
			src={heroBg2}
			alt="Kegiatan warga menyetorkan sampah"
			widths={[640, 960, 1280, 1920]}
			sizes="100vw"
			loading="eager"
			fetchpriority="high"
			decoding="sync"
			class="hero-foto foto-fade"
		/>
		<div class="hero-scrim"></div>
	</div>

	<!-- ════ SLIDE 1: TEKS HEADLINE & 2 TOMBOL CTA ════ -->
	<div class="hero-slide slide-1 is-active" id="hero-slide-1">
		<div class="hero-konten">
			<h1 class="hero-judul">{s1.judul}</h1>

			<p class="hero-subjudul">{s1.subjudul}</p>

			<div class="hero-tombol">
				<!-- CTA Utama: WhatsApp -->
				<a
					href={ctaNasabah.url}
					target="_blank"
					rel="noopener noreferrer"
					data-cta
					data-ga4={ctaNasabah.eventGa4}
					class="btn btn-hijau"
				>
					{ctaNasabah.label}
				</a>

				<!-- CTA Sekunder: Anchor link alur -->
				<a href={s1.ctaSekunder.anchor} class="btn btn-outline">
					{s1.ctaSekunder.label}
				</a>
			</div>
		</div>
	</div>

	<!-- ════ SLIDE 2: VIDEO PROFIL YOUTUBE DENGAN TOMBOL CLOSE ════ -->
	<div class="hero-slide slide-2" id="hero-slide-2" aria-hidden="true">
		<div class="video-slide-konten">
			<div class="video-slide-header">
				<div class="video-header-kiri">
					<span class="video-kategori-tag">VIDEO PROFIL</span>
					<h2 class="video-slide-judul">{youtubeJudul}</h2>
				</div>
				
				<!-- Tombol Close: Kembali ke Slide 1 dan Kunci di Foto -->
				<button
					type="button"
					class="btn-tutup-video-slide"
					id="btn-close-video-slide"
					aria-label="Tutup video dan tetap di foto"
					title="Tutup dan kembali ke foto"
				>
					<Ikon nama="x" ukuran={18} />
					<span>Tutup Video</span>
				</button>
			</div>

			<!-- Kartu Wadah Player YouTube -->
			<div class="video-card-frame glass-pekat">
				<div class="video-embed-wadah" id="hero-video-embed">
					<!-- Iframe YouTube dimuat dinamis saat slide 2 aktif -->
				</div>
			</div>
		</div>
	</div>

	<!-- ════ PROGRESS BAR DURASI SLIDE ════ -->
	<div class="slider-timer-bar" id="slider-timer-bar" aria-hidden="true">
		<div class="timer-progress" id="slider-progress-fill"></div>
	</div>
</div>

<script>
	const slide1 = document.getElementById("hero-slide-1");
	const slide2 = document.getElementById("hero-slide-2");
	const videoEmbed = document.getElementById("hero-video-embed");
	const progressFill = document.getElementById("slider-progress-fill");
	const timerBar = document.getElementById("slider-timer-bar");
	const sliderBlok = document.getElementById("hero-slider-blok");
	const btnClose = document.getElementById("btn-close-video-slide");

	if (slide1 && slide2 && videoEmbed && progressFill && sliderBlok) {
		const videoId = sliderBlok.dataset.videoid || "RyqIu_17jFI";
		const videoJudul = sliderBlok.dataset.videojudul || "Video Profil Bank Sampah Bakti Lembur";

		let currentSlide = 1;
		let slideTimer: any = null;
		let isAutoSlideDisabled = false; // Flag jika user menekan close

		// Durasi: Slide 1 (Foto) = 8 detik, Slide 2 (Video) = 30 detik
		const DURATION_SLIDE_1 = 8000;
		const DURATION_SLIDE_2 = 30000;

		const switchSlide = (slideNum: number) => {
			if (isAutoSlideDisabled && slideNum !== 1) return;
			currentSlide = slideNum;

			if (slideNum === 1) {
				slide1.classList.add("is-active");
				slide1.removeAttribute("aria-hidden");
				slide2.classList.remove("is-active");
				slide2.setAttribute("aria-hidden", "true");

				// Hentikan video saat beralih ke slide 1
				videoEmbed.innerHTML = "";
			} else {
				slide2.classList.add("is-active");
				slide2.removeAttribute("aria-hidden");
				slide1.classList.remove("is-active");
				slide1.setAttribute("aria-hidden", "true");

				// Muat dan otomatis putar video YouTube di Slide 2
				videoEmbed.innerHTML = `
					<iframe
						src="https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&rel=0&modestbranding=1"
						title="${videoJudul}"
						allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
						allowfullscreen
						class="iframe-slide-video"
					></iframe>
				`;
			}

			if (!isAutoSlideDisabled) {
				resetTimer();
			}
		};

		const startTimer = () => {
			if (isAutoSlideDisabled) return;
			const duration = currentSlide === 1 ? DURATION_SLIDE_1 : DURATION_SLIDE_2;

			progressFill.style.transition = "none";
			progressFill.style.width = "0%";

			void progressFill.offsetWidth;

			progressFill.style.transition = `width ${duration}ms linear`;
			progressFill.style.width = "100%";

			slideTimer = setTimeout(() => {
				if (!isAutoSlideDisabled) {
					const next = currentSlide === 1 ? 2 : 1;
					switchSlide(next);
				}
			}, duration);
		};

		const resetTimer = () => {
			if (slideTimer) clearTimeout(slideTimer);
			if (!isAutoSlideDisabled) {
				startTimer();
			}
		};

		// Mulai timer awal
		startTimer();

		// (Dihapus: Jeda timer saat user mengarahkan kursor, karena hero full-screen membuat timer terhenti terus-menerus)

		// ─── AKSI TOMBOL CLOSE: KEMBALI KE FOTO & KUNCI (TIDAK OTOMATIS LAGI) ───
		if (btnClose) {
			btnClose.addEventListener("click", () => {
				isAutoSlideDisabled = true;
				if (slideTimer) clearTimeout(slideTimer);

				// Sembunyikan progress bar
				if (timerBar) {
					timerBar.style.display = "none";
				}

				// Kembalikan ke Slide 1 (Foto) secara permanen
				switchSlide(1);
			});
		}
	}
</script>

<style>
	/* ─── Wrapper Full-Screen ────────────────────────────────────────── */
	.hero-blok {
		position: relative;
		isolation: isolate;
		min-height: 100svh;
		width: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
		background: #0b0f0b;
	}

	/* ─── Foto Latar Bersama ─────────────────────────────────────────── */
	.hero-latar {
		position: absolute;
		inset: 0;
		z-index: 0;
	}

	.hero-foto {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center top;
	}

	/* Animasi Crossfade Background tanpa JS */
	.foto-fade {
		opacity: 0;
		animation: crossfadeBg 16s infinite;
	}

	@keyframes crossfadeBg {
		0%, 45% { opacity: 0; }     /* Foto 1 Tampil */
		50%, 95% { opacity: 1; }    /* Foto 2 Tampil (IMG_8919) */
		100% { opacity: 0; }
	}

	.hero-scrim {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			180deg,
			rgba(14, 20, 14, 0.62) 0%,
			rgba(14, 20, 14, 0.68) 50%,
			rgba(14, 20, 14, 0.78) 100%
		);
	}

	/* ─── Slide Container ────────────────────────────────────────────── */
	.hero-slide {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
		transition: opacity 0.7s cubic-bezier(0.4, 0, 0.2, 1), visibility 0.7s ease;
		display: flex;
		align-items: center;
		justify-content: center;
		z-index: 1;
	}

	.hero-slide.is-active {
		opacity: 1;
		visibility: visible;
		pointer-events: auto;
		z-index: 2;
	}

	/* ─── Slide 1: Konten Teks Tengah ────────────────────────────────── */
	.hero-konten {
		position: relative;
		width: 100%;
		max-width: 900px;
		padding: calc(var(--space-unit) * 14) calc(var(--space-unit) * 3)
			calc(var(--space-unit) * 8);
		margin: 0 auto;
		text-align: center;
		color: var(--white);
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: calc(var(--space-unit) * 3);
	}

	/* ─── Judul (Plus Jakarta Sans) ──────────────────────────────────── */
	.hero-judul {
		margin: 0;
		font-family: var(--font-hero), system-ui, sans-serif;
		font-size: clamp(2.25rem, 6vw, 4rem);
		font-weight: 800;
		font-style: italic;
		line-height: 1.15;
		letter-spacing: -0.02em;
		color: var(--white);
		text-shadow: 0 4px 32px rgba(0, 0, 0, 0.5);
		text-wrap: balance;
	}

	/* ─── Subjudul ───────────────────────────────────────────────────── */
	.hero-subjudul {
		margin: 0;
		font-family: var(--font-isi), system-ui, sans-serif;
		font-size: clamp(1rem, 2vw, 1.2rem);
		font-weight: 600;
		line-height: 1.6;
		color: rgba(255, 255, 255, 0.95);
		max-width: 680px;
		text-shadow: 0 2px 16px rgba(0, 0, 0, 0.5);
		text-wrap: pretty;
	}

	/* ─── Tombol CTA (Hanya 2 Tombol: WA & Alur) ─────────────────────── */
	.hero-tombol {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: calc(var(--space-unit) * 1.5);
		flex-wrap: wrap;
		margin-top: calc(var(--space-unit) * 1);
	}

	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: calc(var(--space-unit) * 1);
		min-height: 48px;
		padding: calc(var(--space-unit) * 1.5) calc(var(--space-unit) * 3.5);
		border-radius: 999px;
		font-family: var(--font-isi), system-ui, sans-serif;
		font-size: var(--text-isi);
		font-weight: 600;
		text-decoration: none;
		cursor: pointer;
		transition:
			transform 0.15s ease,
			box-shadow 0.2s ease,
			background-color 0.2s ease;
	}

	/* Tombol Hijau Solid */
	.btn-hijau {
		background: var(--brand-green);
		color: var(--white);
		border: 1px solid var(--brand-green);
		box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
	}

	.btn-hijau:hover {
		background: var(--brand-green-dark);
		border-color: var(--brand-green-dark);
		transform: translateY(-2px);
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
	}

	/* Tombol Outline Kaca */
	.btn-outline {
		background: rgba(18, 24, 18, 0.35);
		color: var(--white);
		border: 1.5px solid rgba(255, 255, 255, 0.85);
		box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
	}

	@supports (backdrop-filter: blur(1px)) or
		(-webkit-backdrop-filter: blur(1px)) {
		.btn-outline {
			-webkit-backdrop-filter: blur(10px);
			backdrop-filter: blur(10px);
		}
	}

	.btn-outline:hover {
		background: rgba(255, 255, 255, 0.18);
		border-color: var(--white);
		transform: translateY(-2px);
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
	}

	/* ─── Slide 2: Video Profil Pop-up Card ──────────────────────────── */
	.video-slide-konten {
		position: relative;
		width: 100%;
		max-width: 860px;
		padding: calc(var(--space-unit) * 12) calc(var(--space-unit) * 3)
			calc(var(--space-unit) * 6);
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: calc(var(--space-unit) * 2);
	}

	.video-slide-header {
		width: 100%;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: calc(var(--space-unit) * 2);
	}

	.video-header-kiri {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: calc(var(--space-unit) * 0.5);
	}

	.video-kategori-tag {
		font-family: var(--font-mono), monospace;
		font-size: 0.75rem;
		letter-spacing: 0.1em;
		color: var(--brand-green-light);
		background: rgba(46, 125, 50, 0.25);
		border: 1px solid rgba(76, 175, 80, 0.3);
		padding: 4px 12px;
		border-radius: 999px;
	}

	.video-slide-judul {
		margin: 0;
		font-family: var(--font-hero), system-ui, sans-serif;
		font-size: clamp(1.1rem, 2.5vw, 1.5rem);
		font-weight: 700;
		color: var(--white);
		text-shadow: 0 2px 12px rgba(0, 0, 0, 0.6);
	}

	/* Tombol Close Video Slide */
	.btn-tutup-video-slide {
		display: inline-flex;
		align-items: center;
		gap: calc(var(--space-unit) * 0.8);
		min-height: 40px;
		padding: calc(var(--space-unit) * 1) calc(var(--space-unit) * 2.5);
		border-radius: 999px;
		border: 1px solid rgba(255, 255, 255, 0.3);
		background: rgba(255, 255, 255, 0.2);
		color: var(--white);
		font-family: var(--font-isi), system-ui, sans-serif;
		font-size: var(--text-kecil);
		font-weight: 600;
		cursor: pointer;
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		transition: background-color 0.2s ease, transform 0.15s ease;
		flex-shrink: 0;
	}

	.btn-tutup-video-slide:hover {
		background: rgba(255, 255, 255, 0.35);
		border-color: rgba(255, 255, 255, 0.6);
		transform: translateY(-1px);
	}

	.video-card-frame {
		width: 100%;
		border-radius: var(--radius-lg);
		padding: calc(var(--space-unit) * 1.5);
		background: rgba(18, 24, 18, 0.85);
		border: 1px solid rgba(255, 255, 255, 0.2);
		box-shadow: 0 24px 64px rgba(0, 0, 0, 0.8);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
	}

	.video-embed-wadah {
		position: relative;
		width: 100%;
		aspect-ratio: 16 / 9;
		background: #000;
		border-radius: var(--radius-md);
		overflow: hidden;
	}

	:global(.iframe-slide-video) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
	}

	/* ─── Timer Progress Bar di Bawah ────────────────────────────────── */
	.slider-timer-bar {
		position: absolute;
		bottom: 0;
		left: 0;
		right: 0;
		height: 3px;
		background: rgba(255, 255, 255, 0.1);
		z-index: 10;
	}

	.timer-progress {
		height: 100%;
		width: 0%;
		background: var(--brand-green-light);
		box-shadow: 0 0 8px var(--brand-green-light);
	}

	/* ─── Desktop ──────────────────────────────────────────────────────── */
	@media (min-width: 768px) {
		.hero-konten {
			padding: calc(var(--space-unit) * 18) calc(var(--space-unit) * 6)
				calc(var(--space-unit) * 12);
		}

		.video-slide-konten {
			padding: calc(var(--space-unit) * 16) calc(var(--space-unit) * 6)
				calc(var(--space-unit) * 8);
		}
	}

	/* ─── Aksesibilitas ────────────────────────────────────────────────── */
	@media (prefers-reduced-transparency: reduce) {
		.btn-outline,
		.btn-tutup-video-slide,
		.video-card-frame {
			background: var(--neutral-900);
			-webkit-backdrop-filter: none;
			backdrop-filter: none;
		}

		.hero-scrim {
			background: rgba(14, 20, 14, 0.75);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-slide {
			transition: none;
		}
		.btn,
		.btn-tutup-video-slide {
			transition: none;
		}
	}
</style>
