---
/**
 * S11 — Kolaborasi & Digitalisasi KKN Kelompok 10
 * Premium closing section sebelum footer
 * Menonjolkan kolaborasi antara KKN dan Bank Sampah
 */
import { Image } from 'astro:assets';
import Seksi from '../ui/Seksi.astro';
import Ikon from '../ui/Ikon.astro';
import { beranda, profil } from '../../data';

import logoBankSampah from '../../assets/images/logo/logobanksampah.png';
import logoKkn from '../../assets/images/logo/logokkn.png';
import logoUin from '../../assets/images/logo/logouin.webp';

const { s11 } = beranda;
---

<Seksi id="kolaborasi" eyebrow={s11.eyebrow} judul={`${s11.judul.awal}${s11.judul.sorot}`} latar="netral" tanpaKepala={true}>
	<div class="kolaborasi-container">
		
		<!-- DECORATIVE BACKGROUND -->
		<div class="dekoral-bg" aria-hidden="true">
			<div class="blob blob-kolaborasi-1"></div>
			<div class="blob blob-kolaborasi-2"></div>
			<div class="pattern-leaf"></div>
		</div>

		<!-- MAIN CONTENT WRAPPER -->
		<div class="kolaborasi-content">
			
			<!-- HEADER KUSTOM DI TENGAH DENGAN STABILO -->
			<header class="kolaborasi-header">
				<p class="eyebrow-kustom">{s11.eyebrow}</p>
				<h2 class="judul-kustom">
					{s11.judul.awal}
					<span class="stabilo-hijau">{s11.judul.sorot}</span>
				</h2>
			</header>

			<!-- TOP SECTION: Heading + Deskripsi -->
			<div class="kolaborasi-intro">
				<h3 class="kolaborasi-subjudul">{s11.subjudul}</h3>
				<p class="kolaborasi-deskripsi">{s11.deskripsi}</p>
			</div>

			<!-- VISUAL KOLABORASI: Logo Section -->
			<div class="kolaborasi-visual">
				
				<!-- KKN SIDE -->
				<div class="kolaborasi-side kolaborasi-side-kkn">
					<div class="logo-container logo-kkn">
						<Image
							src={logoKkn}
							alt="Logo KKN Kelompok 10"
							width={100}
							height={100}
							loading="lazy"
							decoding="async"
							class="logo-img"
						/>
					</div>
					<div class="side-info">
						<p class="side-label">KKN KELOMPOK 10</p>
						<p class="side-detail">UIN Sunan Gunung Djati Bandung</p>
					</div>
				</div>

				<!-- CONNECTOR -->
				<div class="kolaborasi-connector">
					<div class="connector-symbol">×</div>
					<div class="connector-line"></div>
				</div>

				<!-- BANK SAMPAH SIDE -->
				<div class="kolaborasi-side kolaborasi-side-bank">
					<div class="logo-container logo-bank">
						<Image
							src={logoBankSampah}
							alt="Logo Bank Sampah Bakti Lembur"
							width={100}
							height={100}
							loading="lazy"
							decoding="async"
							class="logo-img"
						/>
					</div>
					<div class="side-info">
						<p class="side-label">BANK SAMPAH</p>
						<p class="side-detail">Bakti Lembur Sarimukti</p>
					</div>
				</div>

			</div>

			<!-- IMPACT POINTS GRID -->
			<div class="impact-grid">
				{s11.impactPoints.map((point, idx) => (
					<div class="impact-card" style={`--card-delay: ${idx * 80}ms`}>
						<div class="impact-card-inner">
							<div class="impact-icon-wrap">
								{point.icon === 'globe' && <Ikon nama="globe" ukuran={24} />}
								{point.icon === 'calendar' && <Ikon nama="calendar" ukuran={24} />}
								{point.icon === 'leaf' && <Ikon nama="leaf" ukuran={24} />}
							</div>
							<h3 class="impact-title">{point.judul}</h3>
							<p class="impact-desc">{point.deskripsi}</p>
						</div>
					</div>
				))}
			</div>

		</div>

	</div>
</Seksi>

<style>
	/* ─── CONTAINER UTAMA ─────────────────────────────────────────────── */
	.kolaborasi-container {
		position: relative;
		width: 100%;
		max-width: 1140px;
		margin: 0 auto;
		padding: calc(var(--space-unit) * 6) 0;
	}

	/* ─── DECORATIVE BACKGROUND ──────────────────────────────────────── */
	.dekoral-bg {
		position: absolute;
		inset: 0;
		z-index: 0;
		pointer-events: none;
		overflow: hidden;
		border-radius: var(--radius-lg);
	}

	.blob {
		position: absolute;
		border-radius: 50%;
		filter: blur(80px);
		opacity: 0.06;
		mix-blend-mode: screen;
	}

	.blob-kolaborasi-1 {
		width: 450px;
		height: 450px;
		background: linear-gradient(135deg, var(--brand-green) 0%, var(--brand-green-light) 100%);
		top: -150px;
		right: -100px;
		animation: floatKol1 10s ease-in-out infinite;
	}

	.blob-kolaborasi-2 {
		width: 400px;
		height: 400px;
		background: linear-gradient(135deg, var(--accent-earth) 0%, var(--brand-green-light) 100%);
		bottom: -100px;
		left: -150px;
		animation: floatKol2 12s ease-in-out infinite;
	}

	@keyframes floatKol1 {
		0%, 100% { transform: translateY(0px); }
		50% { transform: translateY(40px); }
	}

	@keyframes floatKol2 {
		0%, 100% { transform: translateY(0px); }
		50% { transform: translateY(-40px); }
	}

	/* Leaf pattern */
	.pattern-leaf {
		position: absolute;
		width: 100px;
		height: 100px;
		background: radial-gradient(circle, var(--brand-green-light), transparent);
		border-radius: 50% 0;
		opacity: 0.08;
		top: 20%;
		left: 5%;
		transform: rotate(-45deg);
	}

	/* ─── MAIN CONTENT ────────────────────────────────────────────────── */
	.kolaborasi-content {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		gap: calc(var(--space-unit) * 6);
	}

	/* ─── HEADER TENGAH KUSTOM ───────────────────────────────────────── */
	.kolaborasi-header {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: var(--space-unit);
		margin-bottom: calc(var(--space-unit) * 1);
	}

	.eyebrow-kustom {
		margin: 0;
		font-family: var(--font-mono), monospace;
		font-size: 0.85rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--brand-green);
	}

	.judul-kustom {
		margin: 0;
		font-family: var(--font-hero), system-ui, sans-serif;
		font-size: var(--text-seksi);
		font-weight: 800;
		font-style: italic;
		letter-spacing: -0.02em;
		color: var(--neutral-900);
	}

	.stabilo-hijau {
		position: relative;
		display: inline-block;
		white-space: nowrap;
		z-index: 1;
	}

	.stabilo-hijau::before {
		content: '';
		position: absolute;
		left: -4px;
		right: -4px;
		bottom: 10%;
		height: 36%;
		background: rgba(144, 238, 144, 0.7); /* Light green / hijau muda stabilo */
		z-index: -1;
		border-radius: 4px;
		transform: rotate(-1.5deg);
	}

	/* ─── INTRO SECTION ──────────────────────────────────────────────── */
	.kolaborasi-intro {
		display: flex;
		flex-direction: column;
		gap: calc(var(--space-unit) * 2);
		text-align: center;
		max-width: 700px;
		margin: 0 auto;
	}

	.kolaborasi-subjudul {
		margin: 0;
		font-family: var(--font-hero), system-ui, sans-serif;
		font-size: clamp(1.5rem, 3vw, 1.75rem);
		font-weight: 700;
		color: var(--brand-green-dark);
		line-height: 1.3;
		text-wrap: balance;
	}

	.kolaborasi-deskripsi {
		margin: 0;
		font-family: var(--font-isi), system-ui, sans-serif;
		font-size: 1rem;
		font-weight: 400;
		line-height: 1.7;
		color: var(--neutral-700);
		text-wrap: pretty;
	}

	/* ─── VISUAL KOLABORASI ──────────────────────────────────────────── */
	.kolaborasi-visual {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		gap: calc(var(--space-unit) * 4);
		align-items: center;
		padding: calc(var(--space-unit) * 6);
		background: linear-gradient(
			135deg,
			rgba(62, 116, 53, 0.08) 0%,
			rgba(62, 116, 53, 0.04) 50%,
			rgba(201, 123, 33, 0.06) 100%
		);
		border: 1px solid rgba(62, 116, 53, 0.15);
		border-radius: var(--radius-lg);
		backdrop-filter: blur(4px);
		animation: introFadeUp 0.6s cubic-bezier(0.4, 0, 0.2, 1);
	}

	@keyframes introFadeUp {
		from {
			opacity: 0;
			transform: translateY(20px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.kolaborasi-visual {
			animation: none;
		}
	}

	/* Kolaborasi Side */
	.kolaborasi-side {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: calc(var(--space-unit) * 2);
		transition: transform 0.3s ease, filter 0.3s ease;
	}

	.kolaborasi-visual:hover .kolaborasi-side {
		transform: translateY(-4px);
	}

	.logo-container {
		position: relative;
		width: 100px;
		height: 100px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: linear-gradient(
			135deg,
			rgba(255, 255, 255, 0.8) 0%,
			rgba(234, 242, 232, 0.4) 100%
		);
		border: 2px solid rgba(62, 116, 53, 0.2);
		border-radius: 20px;
		box-shadow: 0 8px 24px rgba(62, 116, 53, 0.1);
		transition: all 0.3s ease;
		backdrop-filter: blur(8px);
	}

	.kolaborasi-side:hover .logo-container {
		border-color: rgba(62, 116, 53, 0.4);
		box-shadow: 0 12px 36px rgba(62, 116, 53, 0.15);
		background: linear-gradient(
			135deg,
			rgba(255, 255, 255, 0.95) 0%,
			rgba(234, 242, 232, 0.5) 100%
		);
		transform: scale(1.08);
	}

	.logo-img {
		width: 70%;
		height: 70%;
		object-fit: contain;
	}

	.side-info {
		text-align: center;
		display: flex;
		flex-direction: column;
		gap: 4px;
	}

	.side-label {
		margin: 0;
		font-family: var(--font-mono), monospace;
		font-size: 0.75rem;
		letter-spacing: 0.15em;
		color: var(--brand-green);
		text-transform: uppercase;
		font-weight: 700;
	}

	.side-detail {
		margin: 0;
		font-family: var(--font-isi), system-ui, sans-serif;
		font-size: 0.85rem;
		font-weight: 500;
		color: var(--neutral-700);
		line-height: 1.4;
	}

	/* Connector */
	.kolaborasi-connector {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 12px;
	}

	.connector-symbol {
		font-family: var(--font-hero), system-ui, sans-serif;
		font-size: 2.5rem;
		font-weight: 300;
		color: rgba(62, 116, 53, 0.4);
		line-height: 1;
	}

	.connector-line {
		width: 2px;
		height: 60px;
		background: linear-gradient(
			180deg,
			transparent,
			rgba(62, 116, 53, 0.3),
			transparent
		);
		border-radius: 1px;
	}

	/* ─── IMPACT GRID ────────────────────────────────────────────────── */
	.impact-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: calc(var(--space-unit) * 4);
		margin-top: calc(var(--space-unit) * 2);
	}

	/* Impact Card */
	.impact-card {
		animation: cardFadeInUp 0.5s cubic-bezier(0.4, 0, 0.2, 1) backwards;
		animation-delay: var(--card-delay);
	}

	@keyframes cardFadeInUp {
		from {
			opacity: 0;
			transform: translateY(30px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.impact-card {
			animation: none;
		}
	}

	.impact-card-inner {
		position: relative;
		overflow: hidden;
		padding: calc(var(--space-unit) * 4);
		border-radius: var(--radius-md);
		background: linear-gradient(
			135deg,
			rgba(62, 116, 53, 0.08) 0%,
			rgba(62, 116, 53, 0.03) 100%
		);
		border: 1px solid rgba(62, 116, 53, 0.15);
		transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
		cursor: pointer;
		display: flex;
		flex-direction: column;
		gap: calc(var(--space-unit) * 2);
		min-height: 220px;
	}

	.impact-card-inner::before {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(
			135deg,
			rgba(62, 116, 53, 0.05),
			transparent
		);
		opacity: 0;
		transition: opacity 0.3s ease;
	}

	.impact-card:hover .impact-card-inner {
		transform: translateY(-8px);
		border-color: rgba(62, 116, 53, 0.3);
		background: linear-gradient(
			135deg,
			rgba(62, 116, 53, 0.12) 0%,
			rgba(201, 123, 33, 0.06) 100%
		);
		box-shadow: 0 16px 40px rgba(62, 116, 53, 0.15);
	}

	.impact-card:hover .impact-card-inner::before {
		opacity: 1;
	}

	/* Impact Icon */
	.impact-icon-wrap {
		position: relative;
		width: 56px;
		height: 56px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: linear-gradient(
			135deg,
			var(--brand-green),
			var(--accent-earth)
		);
		color: var(--white);
		border-radius: 14px;
		transition: all 0.3s ease;
		z-index: 1;
	}

	.impact-card:hover .impact-icon-wrap {
		transform: scale(1.12) rotate(-8deg);
		box-shadow: 0 8px 20px rgba(62, 116, 53, 0.25);
	}

	/* Impact Title */
	.impact-title {
		margin: 0;
		font-family: var(--font-hero), system-ui, sans-serif;
		font-size: 1.125rem;
		font-weight: 700;
		color: var(--neutral-900);
		line-height: 1.3;
		z-index: 1;
		position: relative;
	}

	/* Impact Description */
	.impact-desc {
		margin: 0;
		font-family: var(--font-isi), system-ui, sans-serif;
		font-size: 0.9375rem;
		font-weight: 400;
		line-height: 1.6;
		color: var(--neutral-700);
		z-index: 1;
		position: relative;
	}

	/* ─── RESPONSIVE ─────────────────────────────────────────────────── */
	@media (max-width: 768px) {
		.kolaborasi-container {
			padding: calc(var(--space-unit) * 4) 0;
		}

		.kolaborasi-visual {
			grid-template-columns: 1fr;
			gap: calc(var(--space-unit) * 3);
			padding: calc(var(--space-unit) * 4);
		}

		.kolaborasi-connector {
			order: -1;
			gap: 8px;
		}

		.connector-line {
			width: 60px;
			height: 2px;
		}

		.connector-symbol {
			font-size: 2rem;
		}

		.impact-grid {
			grid-template-columns: 1fr;
			gap: calc(var(--space-unit) * 3);
		}

		.kolaborasi-intro {
			max-width: 100%;
		}
	}

	/* ─── ACCESSIBILITY ──────────────────────────────────────────────── */
	@media (prefers-reduced-transparency: reduce) {
		.blob {
			opacity: 0.12;
		}

		.logo-container {
			background: rgba(255, 255, 255, 0.9);
		}

		.kolaborasi-visual {
			background: rgba(62, 116, 53, 0.15);
		}

		.impact-card-inner {
			background: rgba(62, 116, 53, 0.12);
		}

		.impact-card:hover .impact-card-inner {
			background: rgba(62, 116, 53, 0.18);
		}
	}
</style>
