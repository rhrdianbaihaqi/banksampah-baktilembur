---
/**
 * S11 — Kolaborasi & Digitalisasi KKN Kelompok 10
 * Premium closing section sebelum footer
 * Menonjolkan kolaborasi antara KKN dan Bank Sampah
 */
import { Image } from "astro:assets";
import Seksi from "../ui/Seksi.astro";
import Ikon from "../ui/Ikon.astro";
import { beranda, profil } from "../../data";

import logoBankSampah from "../../assets/images/logo/logobanksampah.png";
import logoKkn from "../../assets/images/logo/logokkn.png";
import logoUin from "../../assets/images/logo/logouin.webp";

import { FaMobileAlt, FaGlobeEurope } from "react-icons/fa";
import { RiCustomerService2Fill } from "react-icons/ri";

const { s11 } = beranda;

/** 3 React Icons untuk impact cards */
const impactIcons = [
	FaMobileAlt, // 1. Informasi Digital / Aplikasi
	RiCustomerService2Fill, // 2. Informasi Layanan / Konsultasi
	FaGlobeEurope, // 3. Jangkauan Lebih Luas / Website
];
---

<section
	id="kolaborasi"
	class="seksi-kolaborasi"
	aria-label="Kolaborasi KKN Kelompok 10"
>
	<div class="kolaborasi-container">
		<!-- DECORATIVE BACKGROUND -->
		<div class="dekoral-bg" aria-hidden="true">
			<div class="blob blob-kolaborasi-1"></div>
			<div class="blob blob-kolaborasi-2"></div>
			<div class="pattern-leaf"></div>
		</div>

		<!-- MAIN CONTENT WRAPPER -->
		<div class="kolaborasi-content">
			<!-- HEADER KUSTOM DI TENGAH DENGAN STABILO -->
			<header class="kolaborasi-header">
				<p class="eyebrow-kustom">{s11.eyebrow}</p>
				<h2 class="judul-kustom">
					{s11.judul.awal}
					<span class="stabilo-hijau">{s11.judul.sorot}</span>
				</h2>
			</header>

			<!-- TOP SECTION: Heading + Deskripsi -->
			<div class="kolaborasi-intro">
				<h3 class="kolaborasi-subjudul">{s11.subjudul}</h3>
				<p class="kolaborasi-deskripsi">{s11.deskripsi}</p>
			</div>

			<!-- VISUAL KOLABORASI: Logo Section -->
			<div class="kolaborasi-visual">
				<!-- KKN SIDE -->
				<div class="kolaborasi-side kolaborasi-side-kkn">
					<div class="logo-container logo-kkn">
						<Image
							src={logoKkn}
							alt="Logo KKN Kelompok 10"
							height={90}
							loading="lazy"
							decoding="async"
							class="logo-img"
						/>
					</div>
					<div class="side-info">
						<h4 class="side-label">KKN KELOMPOK 10</h4>
						<p class="side-detail">UIN Sunan Gunung Djati Bandung</p>
						<span class="institusi-badge">Inisiator Digital</span>
					</div>
				</div>

				<!-- CONNECTOR (Simple X di tengah logo) -->
				<div class="kolaborasi-connector" aria-hidden="true">
					<span class="connector-simpel">×</span>
				</div>

				<!-- BANK SAMPAH SIDE -->
				<div class="kolaborasi-side kolaborasi-side-bank">
					<div class="logo-container logo-bank">
						<Image
							src={logoBankSampah}
							alt="Logo Bank Sampah Bakti Lembur"
							height={90}
							loading="lazy"
							decoding="async"
							class="logo-img logo-bs"
						/>
					</div>
					<div class="side-info">
						<h4 class="side-label">BANK SAMPAH</h4>
						<p class="side-detail">Bakti Lembur Sarimukti</p>
						<span class="institusi-badge">Mitra Lembaga</span>
					</div>
				</div>
			</div>

			<!-- IMPACT POINTS GRID -->
			<div class="impact-grid">
				{
					s11.impactPoints.map((point, idx) => {
						const IkonComp = impactIcons[idx];
						return (
							<div
								class="impact-card"
								style={`--card-delay: ${idx * 80}ms`}
							>
								<div class="impact-card-inner">
									<div class="impact-icon-wrap">
										<IkonComp size={28} />
									</div>
									<h3 class="impact-title">{point.judul}</h3>
									<p class="impact-desc">{point.deskripsi}</p>
								</div>
							</div>
						);
					})
				}
			</div>
		</div>
	</div>
</section>

<style>
	/* ─── CONTAINER UTAMA ─────────────────────────────────────────────── */
	.seksi-kolaborasi {
		position: relative;
		padding: calc(var(--space-unit) * 3) calc(var(--space-unit) * 3) calc(var(--space-unit) * 10);
		background: var(--neutral-50);
		overflow: hidden;
	}

	.kolaborasi-container {
		position: relative;
		width: 100%;
		max-width: 1140px;
		margin: 0 auto;
		padding: 0;
	}

	/* ─── DECORATIVE BACKGROUND ──────────────────────────────────────── */
	.dekoral-bg {
		position: absolute;
		inset: 0;
		z-index: 0;
		pointer-events: none;
		overflow: hidden;
		border-radius: var(--radius-lg);
	}

	.blob {
		position: absolute;
		border-radius: 50%;
		filter: blur(80px);
		opacity: 0.06;
		mix-blend-mode: screen;
	}

	.blob-kolaborasi-1 {
		width: 450px;
		height: 450px;
		background: linear-gradient(
			135deg,
			var(--brand-green) 0%,
			var(--brand-green-light) 100%
		);
		top: -150px;
		right: -100px;
		animation: floatKol1 10s ease-in-out infinite;
	}

	.blob-kolaborasi-2 {
		width: 400px;
		height: 400px;
		background: linear-gradient(
			135deg,
			var(--accent-earth) 0%,
			var(--brand-green-light) 100%
		);
		bottom: -100px;
		left: -150px;
		animation: floatKol2 12s ease-in-out infinite;
	}

	@keyframes floatKol1 {
		0%,
		100% {
			transform: translateY(0px);
		}
		50% {
			transform: translateY(40px);
		}
	}

	@keyframes floatKol2 {
		0%,
		100% {
			transform: translateY(0px);
		}
		50% {
			transform: translateY(-40px);
		}
	}

	/* Leaf pattern */
	.pattern-leaf {
		position: absolute;
		width: 100px;
		height: 100px;
		background: radial-gradient(
			circle,
			var(--brand-green-light),
			transparent
		);
		border-radius: 50% 0;
		opacity: 0.08;
		top: 20%;
		left: 5%;
		transform: rotate(-45deg);
	}

	/* ─── MAIN CONTENT ────────────────────────────────────────────────── */
	.kolaborasi-content {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		gap: calc(var(--space-unit) * 6);
	}

	/* ─── HEADER TENGAH KUSTOM ───────────────────────────────────────── */
	.kolaborasi-header {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: var(--space-unit);
		margin-bottom: calc(var(--space-unit) * 1);
	}

	.eyebrow-kustom {
		margin: 0;
		font-family: var(--font-mono), monospace;
		font-size: 0.85rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--brand-green);
	}

	.judul-kustom {
		margin: 0;
		font-family: var(--font-hero), system-ui, sans-serif;
		font-size: var(--text-seksi);
		font-weight: 800;
		font-style: italic;
		letter-spacing: -0.02em;
		color: var(--neutral-900);
	}

	.stabilo-hijau {
		display: inline;
		background-image: linear-gradient(
			to bottom,
			transparent 52%,
			rgba(144, 238, 144, 0.75) 52%,
			rgba(144, 238, 144, 0.75) 94%,
			transparent 94%
		);
		-webkit-box-decoration-break: clone;
		box-decoration-break: clone;
		padding: 0.05em 0.18em;
		border-radius: 4px;
	}

	/* ─── INTRO SECTION ──────────────────────────────────────────────── */
	.kolaborasi-intro {
		display: flex;
		flex-direction: column;
		gap: calc(var(--space-unit) * 2);
		text-align: center;
		max-width: 900px;
		margin: 0 auto;
		align-items: center;
	}

	.kolaborasi-subjudul {
		margin: 0;
		font-family: var(--font-hero), system-ui, sans-serif;
		font-size: clamp(1.3rem, 2.5vw, 1.75rem);
		font-weight: 700;
		color: var(--brand-green-dark);
		line-height: 1.3;
	}

	.kolaborasi-deskripsi {
		margin: 0;
		font-family: var(--font-isi), system-ui, sans-serif;
		font-size: 1rem;
		font-weight: 400;
		line-height: 1.7;
		color: var(--neutral-700);
		text-wrap: pretty;
		max-width: 760px;
	}

	/* ─── VISUAL KOLABORASI (Clean & Stylish Partnership Card) ──────── */
	.kolaborasi-visual {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		gap: calc(var(--space-unit) * 4);
		align-items: center;
		padding: calc(var(--space-unit) * 5) calc(var(--space-unit) * 6);
		background: var(--white);
		border: 1px solid rgba(62, 116, 53, 0.12);
		border-top: 4px solid var(--brand-green);
		border-radius: var(--radius-md);
		box-shadow: 0 4px 18px rgba(0, 0, 0, 0.04);
		transition: transform 0.25s cubic-bezier(0.2, 1, 0.3, 1), box-shadow 0.25s ease;
		animation: introFadeUp 0.6s cubic-bezier(0.4, 0, 0.2, 1);
		box-sizing: border-box;
	}

	.kolaborasi-visual:hover {
		transform: translateY(-4px);
		box-shadow: 0 12px 28px rgba(0, 0, 0, 0.08);
	}

	@keyframes introFadeUp {
		from {
			opacity: 0;
			transform: translateY(20px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.kolaborasi-visual {
			animation: none;
		}
	}

	/* Kolaborasi Side */
	.kolaborasi-side {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: calc(var(--space-unit) * 1.5);
		height: 100%;
	}

	.logo-container {
		display: flex;
		align-items: center;
		justify-content: center;
		height: 90px;
		width: 100%;
		background: none;
		border: none;
		box-shadow: none;
		padding: 0;
	}

	.logo-img {
		max-height: 86px;
		width: auto;
		max-width: 130px;
		object-fit: contain;
		display: block;
		filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.05));
		transition: transform 0.3s cubic-bezier(0.2, 1, 0.3, 1), filter 0.3s ease;
	}

	.logo-img.logo-bs {
		max-height: 86px;
		width: auto;
		max-width: 220px; /* Leluasa agar teks 'BANK SAMPAH BAKTI LEMBUR' tidak pernah terpotong */
	}

	.kolaborasi-side:hover .logo-img {
		transform: scale(1.06);
		filter: drop-shadow(0 8px 18px rgba(62, 116, 53, 0.15));
	}

	.side-info {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 4px;
		flex-grow: 1;
		width: 100%;
		justify-content: flex-start;
	}

	.side-label {
		margin: 0;
		font-family: var(--font-hero), system-ui, sans-serif;
		font-size: 1.125rem;
		color: var(--brand-green-dark);
		font-weight: 800;
		letter-spacing: -0.01em;
		white-space: nowrap;
	}

	.side-detail {
		margin: 0;
		font-family: var(--font-isi), system-ui, sans-serif;
		font-size: 0.9375rem;
		font-weight: 500;
		color: var(--neutral-600);
		line-height: 1.4;
		min-height: 2.8em;
		display: flex;
		align-items: center;
		justify-content: center;
		text-align: center;
	}

	.institusi-badge {
		display: inline-block;
		margin-top: auto;
		padding: 3px 12px;
		font-size: 0.72rem;
		font-weight: 700;
		font-family: var(--font-mono), monospace;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--brand-green);
		background: var(--brand-green-light);
		border-radius: 20px;
		border: 1px solid rgba(62, 116, 53, 0.15);
		white-space: nowrap;
	}

	/* Connector (Simple X tepat di tengah horizontal kedua logo) */
	.kolaborasi-connector {
		display: flex;
		align-items: center;
		justify-content: center;
		align-self: flex-start;
		margin-top: 24px; /* Tepat di tengah tinggi logo 90px */
		position: relative;
		z-index: 2;
	}

	.connector-simpel {
		font-family: var(--font-hero), system-ui, sans-serif;
		font-size: 2.25rem;
		font-weight: 300;
		color: var(--brand-green);
		line-height: 1;
		user-select: none;
		opacity: 0.85;
		transition: transform 0.25s ease, opacity 0.25s ease;
	}

	.kolaborasi-visual:hover .connector-simpel {
		transform: scale(1.15);
		opacity: 1;
	}

	/* ─── IMPACT GRID ────────────────────────────────────────────────── */
	.impact-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: calc(var(--space-unit) * 4);
		margin-top: calc(var(--space-unit) * 2);
	}

	/* Impact Card */
	.impact-card {
		animation: cardFadeInUp 0.5s cubic-bezier(0.4, 0, 0.2, 1) backwards;
		animation-delay: var(--card-delay);
		height: 100%;
	}

	@keyframes cardFadeInUp {
		from {
			opacity: 0;
			transform: translateY(24px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.impact-card-inner {
		position: relative;
		overflow: hidden;
		padding: calc(var(--space-unit) * 4.5) calc(var(--space-unit) * 3)
			calc(var(--space-unit) * 4);
		border-radius: var(--radius-md);
		background: var(--white);
		border: 1px solid rgba(0, 0, 0, 0.04);
		box-shadow: 0 4px 18px rgba(0, 0, 0, 0.04);
		transition:
			transform 0.25s cubic-bezier(0.2, 1, 0.3, 1),
			box-shadow 0.25s ease;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		height: 100%;
		box-sizing: border-box;
	}

	.impact-card:hover .impact-card-inner {
		transform: translateY(-5px);
		box-shadow: 0 12px 28px rgba(0, 0, 0, 0.08);
	}

	/* Impact Icon (Sesuai dengan card-ikon di S4Alur) */
	.impact-icon-wrap {
		width: 58px;
		height: 58px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: var(--brand-green);
		color: var(--white);
		border-radius: var(--radius-sm);
		box-shadow: 0 4px 14px rgba(62, 116, 53, 0.22);
		margin-bottom: calc(var(--space-unit) * 2.5);
		flex-shrink: 0;
	}

	/* Impact Title */
	.impact-title {
		margin: 0 0 calc(var(--space-unit) * 1.25) 0;
		font-family: var(--font-hero), system-ui, sans-serif;
		font-size: 1.1875rem;
		font-weight: 700;
		color: var(--brand-green-dark);
		line-height: 1.3;
	}

	/* Impact Description */
	.impact-desc {
		margin: 0;
		font-family: var(--font-isi), system-ui, sans-serif;
		font-size: 0.9375rem;
		font-weight: 400;
		line-height: 1.6;
		color: var(--neutral-600);
	}

	/* ─── RESPONSIVE ─────────────────────────────────────────────────── */
	@media (max-width: 768px) {
		.seksi-kolaborasi {
			padding: calc(var(--space-unit) * 3) calc(var(--space-unit) * 2) calc(var(--space-unit) * 8);
		}

		.kolaborasi-container {
			padding: 0;
		}

		.kolaborasi-visual {
			grid-template-columns: 1fr auto 1fr;
			gap: 8px;
			padding: calc(var(--space-unit) * 3.5) calc(var(--space-unit) * 2);
			border-radius: var(--radius-sm);
		}

		.logo-container {
			height: 60px;
		}

		.logo-img {
			max-height: 56px;
			max-width: 80px;
		}

		.logo-img.logo-bs {
			max-height: 56px;
			max-width: 120px;
		}

		.kolaborasi-connector {
			margin-top: 14px;
		}

		.connector-simpel {
			font-size: 1.5rem;
		}

		.side-label {
			font-size: clamp(0.72rem, 3.2vw, 0.875rem);
			letter-spacing: -0.02em;
			white-space: nowrap;
		}

		.side-detail {
			font-size: clamp(0.65rem, 2.6vw, 0.775rem);
			line-height: 1.3;
			min-height: 2.6em;
		}

		.institusi-badge {
			font-size: 0.58rem;
			padding: 2px 7px;
			letter-spacing: 0.04em;
			margin-top: auto;
		}

		.impact-grid {
			grid-template-columns: 1fr;
			gap: calc(var(--space-unit) * 2.5);
		}

		.impact-card-inner {
			padding: calc(var(--space-unit) * 3.5) calc(var(--space-unit) * 2.5);
		}

		.impact-icon-wrap {
			width: 46px;
			height: 46px;
			border-radius: 8px;
			margin-bottom: calc(var(--space-unit) * 1.5);
		}

		.impact-title {
			font-size: 1.0625rem;
		}

		.impact-desc {
			font-size: 0.875rem;
			line-height: 1.5;
		}

		.kolaborasi-intro {
			max-width: 100%;
		}
	}

	@media (max-width: 380px) {
		.kolaborasi-visual {
			padding: calc(var(--space-unit) * 2.5) calc(var(--space-unit) * 1);
			gap: 4px;
		}

		.logo-container {
			height: 50px;
		}

		.logo-img {
			max-height: 46px;
			max-width: 68px;
		}

		.logo-img.logo-bs {
			max-height: 46px;
			max-width: 100px;
		}

		.side-label {
			font-size: 0.6875rem;
		}

		.side-detail {
			font-size: 0.6rem;
			min-height: 2.5em;
		}

		.institusi-badge {
			font-size: 0.52rem;
			padding: 2px 5px;
		}
	}

		.impact-card-inner {
			padding: calc(var(--space-unit) * 4) calc(var(--space-unit) * 2.5);
		}

		.impact-icon-wrap {
			width: 50px;
			height: 50px;
			border-radius: 8px;
			margin-bottom: calc(var(--space-unit) * 2);
		}

		.impact-title {
			font-size: 1.125rem;
		}

		.impact-desc {
			font-size: 0.875rem;
		}

		.kolaborasi-intro {
			max-width: 100%;
		}
	}

	@media (min-width: 640px) and (max-width: 1023px) {
		.impact-grid {
			grid-template-columns: repeat(3, 1fr);
			gap: calc(var(--space-unit) * 2.5);
		}

		.impact-card-inner {
			padding: calc(var(--space-unit) * 3.5) calc(var(--space-unit) * 2);
		}
	}

	/* ─── ACCESSIBILITY ──────────────────────────────────────────────── */
	@media (prefers-reduced-transparency: reduce) {
		.blob {
			opacity: 0.12;
		}

		.logo-container {
			background: rgba(255, 255, 255, 0.9);
		}

		.kolaborasi-visual {
			background: rgba(62, 116, 53, 0.15);
		}

		.impact-card-inner {
			background: rgba(62, 116, 53, 0.12);
		}

		.impact-card:hover .impact-card-inner {
			background: rgba(62, 116, 53, 0.18);
		}
	}
</style>
