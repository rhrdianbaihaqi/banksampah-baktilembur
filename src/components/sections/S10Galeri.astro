---
/**
 * S10 — Galeri Kegiatan. Latar: foto penuh + scrim lembut (PRD §S10).
 *
 * Foto ditarik lewat `galeriTersaring()`, satu-satunya jalur render galeri.
 * Fungsi itu membuang foto ber-`izinTayang: false` atau `adaWajahAnak: true`
 * (§13). Jangan pernah memetakan `galeri.json` langsung di sini.
 *
 * Selama tim KKN belum menyetorkan foto berikut status izinnya, daftar ini
 * kosong dan seksi menampilkan keterangan apa adanya — bukan foto stok.
 */
import { Image } from "astro:assets";
import Seksi from "../ui/Seksi.astro";
import GlassPanel from "../glass/GlassPanel.astro";
import VideoFacade from "../ui/VideoFacade.astro";
import { beranda, galeriTersaring, profil } from "../../data";

const { s10 } = beranda;
const kategori = galeriTersaring();

// Foto galeri disimpan di src/assets/images/ dan dioptimasi astro:assets.
const berkas = import.meta.glob<{ default: ImageMetadata }>(
	"../../assets/images/*.{jpg,jpeg,png,avif,webp}",
);
---

<Seksi
	id="galeri"
	eyebrow={s10.eyebrow}
	judul={s10.judul}
	latar="foto"
	scrim="lembut"
	labelPlaceholder="Kolase kegiatan bank sampah"
>
	{
		kategori.length > 0 ? (
			<ul class="grid">
				{kategori.flatMap((k) =>
					k.foto.map((f) => (
						<li class="sel">
							<figure class="bingkai glass">
								<Image
									src={berkas[
										`../../assets/images/${f.file}`
									]!()}
									alt={f.alt}
									widths={[320, 640, 960]}
									sizes="(min-width: 1000px) 320px, 50vw"
									loading="lazy"
									class="foto"
								/>
								<figcaption class="ket">{f.alt}</figcaption>
							</figure>
						</li>
					)),
				)}
			</ul>
		) : (
			<GlassPanel diAtasFoto>
				<p class="kosong">{s10.kosong}</p>
			</GlassPanel>
		)
	}

	<div class="video">
		<VideoFacade
			idYoutube={profil.video.idYoutube}
			judul={profil.video.judul}
			label={s10.labelVideo}
		/>
	</div>

	<a href={s10.tautanSelengkapnya.href} class="selengkapnya">
		{s10.tautanSelengkapnya.label}
	</a>
</Seksi>

<style>
	.grid {
		display: grid;
		gap: calc(var(--space-unit) * 2);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.bingkai {
		margin: 0;
		padding: var(--space-unit);
	}

	/* Dimensi eksplisit lewat aspect-ratio mencegah pergeseran tata letak
	   saat gambar lazy selesai dimuat (PRD §11.4, CLS < 0,1). */
	.foto {
		display: block;
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		border-radius: var(--radius-sm);
	}

	.ket {
		padding: var(--space-unit) calc(var(--space-unit) * 0.5) 0;
		font-size: var(--text-kecil);
		color: var(--neutral-700);
	}

	.kosong {
		margin: 0;
	}

	.video {
		max-width: 720px;
	}

	.selengkapnya {
		align-self: flex-start;
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		color: var(--white);
		font-weight: 600;
		text-decoration: none;
		border-bottom: 2px solid var(--white);
	}

	@media (min-width: 700px) {
		.grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (min-width: 1000px) {
		.grid {
			grid-template-columns: repeat(4, 1fr);
			gap: calc(var(--space-unit) * 3);
		}
	}
</style>
