---
/**
 * S10 — Galeri Kegiatan.
 * Redesign: Horizontal Slider layout dengan custom header sesuai referensi.
 */
import { Image } from "astro:assets";
import Seksi from "../ui/Seksi.astro";
import Ikon from "../ui/Ikon.astro";
import { beranda, galeriTersaring, profil } from "../../data";

const { s10 } = beranda;
const kategori = galeriTersaring();

// Foto galeri disimpan di src/assets/images/ dan dioptimasi astro:assets.
const berkas = import.meta.glob<{ default: ImageMetadata }>(
	"../../assets/images/**/*.{jpg,JPG,jpeg,JPEG,png,PNG,avif,webp}",
);
---

<Seksi
	id="galeri"
	eyebrow={s10.eyebrow}
	judul={s10.judul}
	latar="netral"
	tanpaKepala={true}
>
	<div class="galeri-kontainer">
		<!-- CUSTOM HEADER (Sesuai Referensi) -->
		<div class="galeri-header-wrap">
			<div class="galeri-title-box">
				<span class="red-line"></span>
				<h2 class="galeri-title"><span class="stabilo-hijau">{s10.judul}</span></h2>
			</div>
		</div>

		<!-- SLIDER -->
		<div class="galeri-slider-wrapper">
			{
				kategori.length > 0 ? (
					<ul class="galeri-track" id="galeri-track">
						{kategori.flatMap((k) =>
							k.foto.map((f) => {
								const imgLoader = berkas[`../../assets/images/${f.file}`];
								if (!imgLoader) return null;
								
								return (
									<li class="galeri-slide">
										<Image
											src={imgLoader()}
											alt={f.alt}
											widths={[320, 640, 960]}
											sizes="(min-width: 1000px) 500px, 85vw"
											loading="lazy"
											class="slide-foto"
										/>
									</li>
								);
							}),
						)}
					</ul>
				) : (
					<div class="galeri-kosong">
						<p>{s10.kosong}</p>
					</div>
				)
			}
		</div>

	</div>
</Seksi>

<style>
	.galeri-kontainer {
		display: flex;
		flex-direction: column;
		width: 100%;
	}

	/* HEADER */
	.galeri-header-wrap {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: calc(var(--space-unit) * 6);
	}

	.galeri-title-box {
		display: flex;
		align-items: center;
		gap: 16px;
	}

	.red-line {
		width: 32px;
		height: 2px;
		background-color: #ef4444; /* Warna merah sesuai gambar */
	}

	.galeri-title {
		font-family: var(--font-hero), system-ui, sans-serif;
		font-size: clamp(2rem, 4vw, 2.5rem);
		font-weight: 800;
		font-style: italic;
		letter-spacing: -0.02em;
		color: var(--neutral-900);
		margin: 0;
	}

	/* Efek Stabilo Hijau Muda pada Judul */
	.stabilo-hijau {
		position: relative;
		display: inline-block;
		white-space: nowrap;
		z-index: 1;
	}

	.stabilo-hijau::before {
		content: '';
		position: absolute;
		left: -4px;
		right: -4px;
		bottom: 10%;
		height: 36%;
		background: rgba(144, 238, 144, 0.7); /* Light green / hijau muda stabilo */
		z-index: -1;
		border-radius: 4px;
		transform: rotate(-1.5deg);
	}

	/* SLIDER WRAPPER (Bleeding Layout) */
	.galeri-slider-wrapper {
		position: relative;
		width: 100vw;
		margin-left: calc(50% - 50vw); /* Memecah batas max-width container */
		margin-bottom: calc(var(--space-unit) * 8);
	}

	.galeri-track {
		display: flex;
		gap: 30px; /* Gap yang lebar antar foto */
		padding: 0;
		margin: 0;
		list-style: none;
		overflow-x: auto;
		scroll-behavior: smooth;
		scroll-snap-type: x mandatory;
		scrollbar-width: none; /* Firefox */
		/* Padding dinamis agar awal slider sejajar dengan batas container (1120px) */
		padding-left: 24px;
		padding-right: 24px;
	}

	.galeri-track::-webkit-scrollbar {
		display: none; /* Chrome/Safari */
	}

	@media (min-width: 768px) {
		.galeri-track {
			padding-left: max(64px, calc((100vw - 1120px) / 2));
			padding-right: max(64px, calc((100vw - 1120px) / 2));
		}
	}

	/* FOTO KOTAK TAJAM */
	.galeri-slide {
		scroll-snap-align: start;
		flex-shrink: 0;
		width: 85vw;
		max-width: 450px;
	}

	.slide-foto {
		width: 100%;
		height: 320px;
		object-fit: cover;
		display: block;
		border-radius: 0; /* Kotak siku-siku sesuai referensi gambar */
	}

	@media (min-width: 768px) {
		.slide-foto {
			height: 380px;
		}
	}

	.galeri-kosong {
		padding-left: max(64px, calc((100vw - 1120px) / 2));
		color: var(--neutral-600);
		font-style: italic;
	}

</style>

<script>
	function setupGaleriSlider() {
		const track = document.getElementById('galeri-track');

		if (!track) return;

		// Hindari penggandaan event listener jika dipanggil berkali-kali
		if (track.hasAttribute('data-slider-init')) return;
		track.setAttribute('data-slider-init', 'true');

		// 1. Clone items untuk seamless infinite loop
		// Kita menduplikasi 2 set item untuk buffer di awal dan akhir
		const originalItems = Array.from(track.children);
		originalItems.forEach(item => {
			const clone = item.cloneNode(true);
			clone.setAttribute('aria-hidden', 'true');
			track.appendChild(clone);
		});
		originalItems.forEach(item => {
			const clone = item.cloneNode(true);
			clone.setAttribute('aria-hidden', 'true');
			track.appendChild(clone);
		});

		let isDown = false;
		let startX;
		let scrollLeft;
		let autoPlayTimer;

		// Menghitung lebar 1 set konten
		const getSetWidth = () => {
			const itemWidth = track.firstElementChild ? track.firstElementChild.clientWidth + 30 : 480; // 30 is gap
			return originalItems.length * itemWidth;
		};

		// Posisikan scroll di tengah (set ke-2) pada saat awal, agar bisa digeser ke kiri
		setTimeout(() => {
			track.style.scrollBehavior = 'auto';
			track.scrollLeft = getSetWidth();
			void track.offsetWidth; // Force reflow
			track.style.scrollBehavior = 'smooth';
		}, 50);

		// --- Auto-play Logic ---
		const startAutoPlay = () => {
			stopAutoPlay();
			autoPlayTimer = setInterval(() => {
				const itemWidth = track.firstElementChild ? track.firstElementChild.clientWidth + 30 : 480;
				track.scrollBy({ left: itemWidth, behavior: 'smooth' });
			}, 3000);
		};

		const stopAutoPlay = () => {
			if (autoPlayTimer) clearInterval(autoPlayTimer);
		};

		startAutoPlay();

		// Seamless Loop Check
		let scrollTimeout;
		track.addEventListener('scroll', () => {
			clearTimeout(scrollTimeout);
			scrollTimeout = setTimeout(() => {
				const setWidth = getSetWidth();
				
				// Jika mencapai set ke-3 (ujung kanan), kembalikan ke set ke-2
				if (track.scrollLeft >= setWidth * 2 - 10) {
					track.style.scrollBehavior = 'auto';
					track.scrollLeft -= setWidth;
					void track.offsetWidth;
					track.style.scrollBehavior = 'smooth';
				} 
				// Jika mencapai set ke-1 (ujung kiri), kembalikan ke set ke-2
				else if (track.scrollLeft <= 10) {
					track.style.scrollBehavior = 'auto';
					track.scrollLeft += setWidth;
					void track.offsetWidth;
					track.style.scrollBehavior = 'smooth';
				}
			}, 150); // Menunggu momentum / smooth scroll berhenti
		});

		// Pause saat interaksi
		track.addEventListener('mouseenter', stopAutoPlay);
		track.addEventListener('mouseleave', startAutoPlay);
		track.addEventListener('touchstart', stopAutoPlay, { passive: true });
		track.addEventListener('touchend', startAutoPlay);

		// --- Drag to Scroll (Mouse) ---
		track.addEventListener('mousedown', (e) => {
			isDown = true;
			track.style.scrollSnapType = 'none';
			track.style.scrollBehavior = 'auto';
			track.style.cursor = 'grabbing';
			startX = e.pageX - track.offsetLeft;
			scrollLeft = track.scrollLeft;
			stopAutoPlay();
		});

		track.addEventListener('mouseleave', () => {
			if (!isDown) return;
			isDown = false;
			track.style.scrollSnapType = 'x mandatory';
			track.style.scrollBehavior = 'smooth';
			track.style.cursor = 'grab';
			startAutoPlay();
		});

		track.addEventListener('mouseup', () => {
			isDown = false;
			track.style.scrollSnapType = 'x mandatory';
			track.style.scrollBehavior = 'smooth';
			track.style.cursor = 'grab';
			startAutoPlay();
		});

		track.addEventListener('mousemove', (e) => {
			if (!isDown) return;
			e.preventDefault();
			const x = e.pageX - track.offsetLeft;
			const walk = (x - startX) * 2;
			track.scrollLeft = scrollLeft - walk;
		});

		track.style.cursor = 'grab';
	}

	// Eksekusi fungsi setup saat komponen dimuat
	setupGaleriSlider();
	
	// Jika menggunakan View Transitions
	document.addEventListener('astro:page-load', setupGaleriSlider);
</script>
