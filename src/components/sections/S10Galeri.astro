---
/**
 * S10 — Galeri Kegiatan.
 * Redesign: Horizontal Slider layout dengan custom header sesuai referensi,
 * dilengkapi foto latar belakang P1139710.jpeg via astro:assets Picture.
 */
import { Image, Picture } from "astro:assets";
import { beranda, galeriTersaring } from "../../data";
import bgGaleri from "../../assets/images/background/P1139710.jpeg";

const { s10 } = beranda;
const kategori = galeriTersaring();

// Foto galeri disimpan di src/assets/images/ dan dioptimasi astro:assets.
const berkas = import.meta.glob<{ default: ImageMetadata }>(
	"../../assets/images/**/*.{jpg,JPG,jpeg,JPEG,png,PNG,avif,webp}",
);
---

<section id="galeri" class="seksi-galeri" aria-label="Galeri Kegiatan">
	<!-- Background gambar dengan scrim sama seperti hero beranda -->
	<div class="latar-belakang-gambar" aria-hidden="true">
		<Picture
			src={bgGaleri}
			alt=""
			formats={['avif', 'webp']}
			widths={[640, 1024, 1600, 2000]}
			sizes="100vw"
			loading="lazy"
			decoding="async"
			class="bg-img"
		/>
		<div class="galeri-scrim"></div>
	</div>

	<div class="galeri-kontainer">
		<!-- CUSTOM HEADER (Sesuai Referensi) -->
		<div class="galeri-header-wrap">
			<div class="galeri-title-box">
				<span class="red-line"></span>
				<h2 class="galeri-title">
					<span class="stabilo-hijau">{s10.judul}</span>
				</h2>
			</div>
		</div>

		<!-- SLIDER -->
		<div class="galeri-slider-wrapper">
			{
				kategori.length > 0 ? (
					<ul class="galeri-track" id="galeri-track">
						{kategori.flatMap((k) =>
							k.foto.map((f) => {
								const imgLoader =
									berkas[`../../assets/images/${f.file}`];
								if (!imgLoader) return null;

								return (
									<li class="galeri-slide">
										<Image
											src={imgLoader()}
											alt={f.alt}
											widths={[320, 640, 960]}
											sizes="(min-width: 1000px) 500px, 85vw"
											loading="lazy"
											class="slide-foto"
										/>
									</li>
								);
							}),
						)}
					</ul>
				) : (
					<div class="galeri-kosong">
						<p>{s10.kosong}</p>
					</div>
				)
			}
		</div>
	</div>
</section>

<style>
	.seksi-galeri {
		position: relative;
		overflow: hidden;
		padding: calc(var(--space-unit) * 10) 0;
		background: #0b0f0b;
	}

	/* LATAR BELAKANG GAMBAR */
	.latar-belakang-gambar {
		position: absolute;
		inset: 0;
		z-index: 0;
		pointer-events: none;
	}

	.bg-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}

	.galeri-scrim {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			180deg,
			rgba(14, 20, 14, 0.62) 0%,
			rgba(14, 20, 14, 0.68) 50%,
			rgba(14, 20, 14, 0.78) 100%
		);
	}

	.galeri-kontainer {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		width: 100%;
		max-width: var(--lebar-kontainer, 1200px);
		margin: 0 auto;
		padding: 0 24px;
		box-sizing: border-box;
	}

	/* HEADER */
	.galeri-header-wrap {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: calc(var(--space-unit) * 6);
	}

	.galeri-title-box {
		display: flex;
		align-items: center;
		gap: 16px;
	}

	.red-line {
		width: 32px;
		height: 3px;
		background-color: #ef4444;
		border-radius: 2px;
	}

	.galeri-title {
		font-family: var(--font-hero), system-ui, sans-serif;
		font-size: clamp(2rem, 4vw, 2.5rem);
		font-weight: 800;
		font-style: italic;
		letter-spacing: -0.02em;
		color: var(--white);
		margin: 0;
		text-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
	}

	/* Efek Stabilo Hijau Muda pada Judul */
	.stabilo-hijau {
		display: inline;
		background-image: linear-gradient(
			to bottom,
			transparent 52%,
			rgba(144, 238, 144, 0.75) 52%,
			rgba(144, 238, 144, 0.75) 94%,
			transparent 94%
		);
		-webkit-box-decoration-break: clone;
		box-decoration-break: clone;
		padding: 0.05em 0.18em;
		border-radius: 4px;
		color: var(--white);
	}

	/* SLIDER WRAPPER (Bleeding Layout) */
	.galeri-slider-wrapper {
		position: relative;
		width: 100vw;
		margin-left: calc(50% - 50vw); /* Memecah batas max-width container */
		margin-bottom: calc(var(--space-unit) * 4);
	}

	.galeri-track {
		display: flex;
		gap: 28px; /* Gap antar foto */
		padding: 0;
		margin: 0;
		list-style: none;
		overflow-x: auto;
		scroll-behavior: smooth;
		scroll-snap-type: x mandatory;
		scrollbar-width: none; /* Firefox */
		padding-left: 24px;
		padding-right: 24px;
	}

	.galeri-track::-webkit-scrollbar {
		display: none; /* Chrome/Safari */
	}

	@media (min-width: 768px) {
		.galeri-track {
			padding-left: max(32px, calc((100vw - 1200px) / 2 + 24px));
			padding-right: max(32px, calc((100vw - 1200px) / 2 + 24px));
		}
	}

	/* FOTO SLIDE */
	.galeri-slide {
		scroll-snap-align: start;
		flex-shrink: 0;
		width: 85vw;
		max-width: 450px;
	}

	.slide-foto {
		width: 100%;
		height: 320px;
		object-fit: cover;
		display: block;
		border-radius: var(--radius-sm);
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
		transition: transform 0.3s cubic-bezier(0.2, 1, 0.3, 1), box-shadow 0.3s ease;
	}

	.galeri-slide:hover .slide-foto {
		transform: scale(1.02);
		box-shadow: 0 14px 32px rgba(0, 0, 0, 0.45);
	}

	@media (min-width: 768px) {
		.slide-foto {
			height: 380px;
		}
	}

	.galeri-kosong {
		padding-left: max(32px, calc((100vw - 1200px) / 2 + 24px));
		color: rgba(255, 255, 255, 0.8);
		font-style: italic;
	}

	/* ─── ACCESSIBILITY ────────────────────────────────────────────── */
	@media (prefers-reduced-motion: reduce) {
		.slide-foto {
			transition: none;
		}
		.galeri-slide:hover .slide-foto {
			transform: none;
		}
	}
</style>

<script>
	function setupGaleriSlider() {
		const track = document.getElementById("galeri-track");

		if (!track) return;

		// Hindari penggandaan event listener jika dipanggil berkali-kali
		if (track.hasAttribute("data-slider-init")) return;
		track.setAttribute("data-slider-init", "true");

		// 1. Clone items untuk seamless infinite loop
		const originalItems = Array.from(track.children);
		originalItems.forEach((item) => {
			const clone = item.cloneNode(true);
			clone.setAttribute("aria-hidden", "true");
			track.appendChild(clone);
		});
		originalItems.forEach((item) => {
			const clone = item.cloneNode(true);
			clone.setAttribute("aria-hidden", "true");
			track.appendChild(clone);
		});

		let isDown = false;
		let startX;
		let scrollLeft;
		let autoPlayTimer;

		// Menghitung lebar 1 set konten
		const getSetWidth = () => {
			const itemWidth = track.firstElementChild
				? track.firstElementChild.clientWidth + 28
				: 478; // 28 is gap
			return originalItems.length * itemWidth;
		};

		// Posisikan scroll di tengah (set ke-2) pada saat awal, agar bisa digeser ke kiri
		setTimeout(() => {
			track.style.scrollBehavior = "auto";
			track.scrollLeft = getSetWidth();
			void track.offsetWidth; // Force reflow
			track.style.scrollBehavior = "smooth";
		}, 50);

		// --- Auto-play Logic ---
		const startAutoPlay = () => {
			stopAutoPlay();
			autoPlayTimer = setInterval(() => {
				const itemWidth = track.firstElementChild
					? track.firstElementChild.clientWidth + 28
					: 478;
				track.scrollBy({ left: itemWidth, behavior: "smooth" });
			}, 3000);
		};

		const stopAutoPlay = () => {
			if (autoPlayTimer) clearInterval(autoPlayTimer);
		};

		startAutoPlay();

		// Seamless Loop Check
		let scrollTimeout;
		track.addEventListener("scroll", () => {
			clearTimeout(scrollTimeout);
			scrollTimeout = setTimeout(() => {
				const setWidth = getSetWidth();

				// Jika mencapai set ke-3 (ujung kanan), kembalikan ke set ke-2
				if (track.scrollLeft >= setWidth * 2 - 10) {
					track.style.scrollBehavior = "auto";
					track.scrollLeft -= setWidth;
					void track.offsetWidth;
					track.style.scrollBehavior = "smooth";
				}
				// Jika mencapai set ke-1 (ujung kiri), kembalikan ke set ke-2
				else if (track.scrollLeft <= 10) {
					track.style.scrollBehavior = "auto";
					track.scrollLeft += setWidth;
					void track.offsetWidth;
					track.style.scrollBehavior = "smooth";
				}
			}, 150);
		});

		// Pause saat interaksi
		track.addEventListener("mouseenter", stopAutoPlay);
		track.addEventListener("mouseleave", startAutoPlay);
		track.addEventListener("touchstart", stopAutoPlay, { passive: true });
		track.addEventListener("touchend", startAutoPlay);

		// --- Drag to Scroll (Mouse) ---
		track.addEventListener("mousedown", (e) => {
			isDown = true;
			track.style.scrollSnapType = "none";
			track.style.scrollBehavior = "auto";
			track.style.cursor = "grabbing";
			startX = e.pageX - track.offsetLeft;
			scrollLeft = track.scrollLeft;
			stopAutoPlay();
		});

		track.addEventListener("mouseleave", () => {
			if (!isDown) return;
			isDown = false;
			track.style.scrollSnapType = "x mandatory";
			track.style.scrollBehavior = "smooth";
			track.style.cursor = "grab";
			startAutoPlay();
		});

		track.addEventListener("mouseup", () => {
			isDown = false;
			track.style.scrollSnapType = "x mandatory";
			track.style.scrollBehavior = "smooth";
			track.style.cursor = "grab";
			startAutoPlay();
		});

		track.addEventListener("mousemove", (e) => {
			if (!isDown) return;
			e.preventDefault();
			const x = e.pageX - track.offsetLeft;
			const walk = (x - startX) * 2;
			track.scrollLeft = scrollLeft - walk;
		});

		track.style.cursor = "grab";
	}

	// Eksekusi fungsi setup saat komponen dimuat
	setupGaleriSlider();

	// Jika menggunakan View Transitions
	document.addEventListener("astro:page-load", setupGaleriSlider);
</script>
