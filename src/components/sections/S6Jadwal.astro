---
/**
 * S6 — Jadwal & Lokasi Penimbangan.
 * Layout 2-kolom: info jadwal di kiri, lokasi & peta Google Maps di kanan.
 * Menggunakan React Icons: FaCalendarAlt & FaMapLocationDot.
 * Disesuaikan dengan skala lebih ramping dan tanpa aksen coklat.
 */
import Seksi from "../ui/Seksi.astro";
import { beranda, profil } from "../../data";
import { FaCalendarAlt } from "react-icons/fa";
import { FaMapLocationDot } from "react-icons/fa6";

const { s6 } = beranda;
const { jadwalPenimbangan, areaJemput, alamat, koordinat } = profil;
const tautanMaps = koordinat?.tautanMaps || "https://share.google/baPqq1nswNfF5SEc1";
---

<Seksi id="jadwal" eyebrow={s6.eyebrow} judul={s6.judul} latar="netral">
	<div class="jadwal-grid">
		<!-- KARTU 1: Jadwal Penimbangan -->
		<div class="jadwal-card">
			<div class="card-header">
				<div class="card-ikon-wrap">
					<FaCalendarAlt size={22} />
				</div>
				<div class="header-text">
					<span class="card-kategori">{s6.eyebrow}</span>
					<h3 class="card-judul">{s6.labelJadwal}</h3>
				</div>
			</div>

			<div class="card-body">
				<div class="frekuensi-badge">
					<span class="frekuensi-label">Frekuensi Layanan</span>
					<h4 class="frekuensi-nilai">{jadwalPenimbangan.frekuensi}</h4>
				</div>

				<div class="info-section">
					<span class="section-label">Hari Penimbangan Rutin:</span>
					<div class="hari-tags">
						{
							jadwalPenimbangan.hari.map((h) => (
								<span class="hari-tag">
									<span class="tag-bullet" aria-hidden="true" />
									Hari {h}
								</span>
							))
						}
					</div>
				</div>

				<div class="info-catatan">
					<p class="catatan-teks">
						Warga dan nasabah dapat membawa tabungan sampah terpilah langsung ke lokasi penimbangan sesuai jadwal di atas.
					</p>
				</div>
			</div>
		</div>

		<!-- KARTU 2: Lokasi, Area Layanan & Peta Muncul -->
		<div class="jadwal-card">
			<div class="card-header">
				<div class="card-ikon-wrap">
					<FaMapLocationDot size={22} />
				</div>
				<div class="header-text">
					<span class="card-kategori">{s6.labelLokasi}</span>
					<h3 class="card-judul">Lokasi & Titik Kumpul</h3>
				</div>
			</div>

			<div class="card-body">
				<div class="alamat-box">
					<p class="alamat-teks">{alamat.lengkap}</p>
				</div>

				<div class="info-section">
					<span class="section-label">{s6.labelJemput}:</span>
					<div class="area-tags">
						{
							areaJemput.map((a) => (
								<span class="area-tag">
									<span class="area-dot" aria-hidden="true" />
									{a}
								</span>
							))
						}
					</div>
				</div>

				<!-- PETA INTERAKTIF / EMBED GOOGLE MAPS -->
				<div class="peta-wrapper">
					<iframe
						title="Peta Lokasi Bank Sampah Bakti Lembur"
						src="https://maps.google.com/maps?q=Kp.+Nagrog+Desa+Sarimukti+Kec.+Pasirwangi+Kab.+Garut&t=&z=15&ie=UTF8&iwloc=&output=embed"
						width="100%"
						height="160"
						style="border:0;"
						allowfullscreen=""
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
						class="peta-iframe"
					></iframe>
				</div>

				<!-- TOMBOL BUKA GOOGLE MAPS -->
				<a
					href={tautanMaps}
					target="_blank"
					rel="noopener noreferrer"
					class="btn-maps"
				>
					<FaMapLocationDot size={16} />
					<span>{s6.tombolMaps || "Buka di Google Maps"}</span>
				</a>
			</div>
		</div>
	</div>
</Seksi>

<style>
	/* ─── LAYOUT UTAMA ─────────────────────────────────────────────── */
	.jadwal-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: calc(var(--space-unit) * 3.5);
		align-items: stretch;
	}

	@media (min-width: 900px) {
		.jadwal-grid {
			grid-template-columns: repeat(2, 1fr);
			gap: calc(var(--space-unit) * 3.5);
		}
	}

	/* ─── JADWAL CARD (Sesuai Gaya Kartu Alur & Kolaborasi) ─────────── */
	.jadwal-card {
		background: var(--white);
		border-radius: var(--radius-md);
		border: 1px solid rgba(0, 0, 0, 0.04);
		box-shadow: 0 4px 18px rgba(0, 0, 0, 0.04);
		padding: calc(var(--space-unit) * 3.5) calc(var(--space-unit) * 3);
		display: flex;
		flex-direction: column;
		gap: calc(var(--space-unit) * 2);
		transition: transform 0.25s cubic-bezier(0.2, 1, 0.3, 1), box-shadow 0.25s ease;
		box-sizing: border-box;
		height: 100%;
	}

	.jadwal-card:hover {
		transform: translateY(-4px);
		box-shadow: 0 10px 24px rgba(0, 0, 0, 0.07);
	}

	/* Card Header */
	.card-header {
		display: flex;
		align-items: center;
		gap: calc(var(--space-unit) * 2);
		padding-bottom: calc(var(--space-unit) * 1.75);
		border-bottom: 1px solid rgba(62, 116, 53, 0.08);
	}

	.card-ikon-wrap {
		width: 48px;
		height: 48px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: var(--brand-green);
		color: var(--white);
		border-radius: var(--radius-sm);
		box-shadow: 0 4px 12px rgba(62, 116, 53, 0.2);
		flex-shrink: 0;
	}

	.header-text {
		display: flex;
		flex-direction: column;
		gap: 1px;
	}

	.card-kategori {
		font-family: var(--font-mono), monospace;
		font-size: 0.7rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--brand-green);
	}

	.card-judul {
		margin: 0;
		font-family: var(--font-hero), system-ui, sans-serif;
		font-size: 1.125rem;
		font-weight: 700;
		color: var(--brand-green-dark);
		line-height: 1.25;
	}

	/* Card Body */
	.card-body {
		display: flex;
		flex-direction: column;
		gap: calc(var(--space-unit) * 2);
		flex-grow: 1;
	}

	/* Frekuensi Badge */
	.frekuensi-badge {
		background: var(--brand-green-light);
		padding: calc(var(--space-unit) * 1.75) calc(var(--space-unit) * 2.25);
		border-radius: var(--radius-sm);
		border: 1px solid rgba(62, 116, 53, 0.12);
		display: flex;
		flex-direction: column;
		gap: 2px;
	}

	.frekuensi-label {
		font-family: var(--font-mono), monospace;
		font-size: 0.6875rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--brand-green);
	}

	.frekuensi-nilai {
		margin: 0;
		font-family: var(--font-hero), system-ui, sans-serif;
		font-size: 1.1875rem;
		font-weight: 800;
		color: var(--brand-green-dark);
	}

	/* Section Label */
	.section-label {
		display: block;
		font-family: var(--font-hero), system-ui, sans-serif;
		font-size: 0.875rem;
		font-weight: 700;
		color: var(--neutral-800);
		margin-bottom: calc(var(--space-unit) * 1);
	}

	/* Hari Tags */
	.hari-tags {
		display: flex;
		flex-wrap: wrap;
		gap: calc(var(--space-unit) * 0.75);
	}

	.hari-tag {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 5px 12px;
		background: var(--brand-green);
		color: var(--white);
		border-radius: 999px;
		font-family: var(--font-isi), system-ui, sans-serif;
		font-size: 0.8125rem;
		font-weight: 600;
		box-shadow: 0 2px 6px rgba(62, 116, 53, 0.2);
	}

	.tag-bullet {
		width: 5px;
		height: 5px;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.75);
	}

	/* Catatan Teks */
	.info-catatan {
		background: var(--brand-green-light);
		border-radius: var(--radius-sm);
		padding: calc(var(--space-unit) * 1.5) calc(var(--space-unit) * 2);
		border-left: 3px solid var(--brand-green);
	}

	.catatan-teks {
		margin: 0;
		font-family: var(--font-isi), system-ui, sans-serif;
		font-size: 0.8125rem;
		color: var(--neutral-700);
		line-height: 1.5;
	}

	/* Alamat Box */
	.alamat-box {
		padding: calc(var(--space-unit) * 1.5) calc(var(--space-unit) * 2);
		background: var(--neutral-50);
		border-radius: var(--radius-sm);
		border: 1px solid rgba(0, 0, 0, 0.05);
	}

	.alamat-teks {
		margin: 0;
		font-family: var(--font-isi), system-ui, sans-serif;
		font-size: 0.875rem;
		color: var(--neutral-800);
		line-height: 1.45;
		font-weight: 500;
	}

	/* Area Tags */
	.area-tags {
		display: flex;
		flex-wrap: wrap;
		gap: calc(var(--space-unit) * 0.75);
	}

	.area-tag {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 5px 10px;
		border-radius: var(--radius-sm);
		font-family: var(--font-isi), system-ui, sans-serif;
		font-size: 0.75rem;
		font-weight: 600;
		color: var(--neutral-700);
		background: var(--neutral-50);
		border: 1px solid rgba(0, 0, 0, 0.06);
		transition: all 0.2s ease;
	}

	.area-tag:hover {
		background: var(--brand-green-light);
		border-color: var(--brand-green);
		color: var(--brand-green-dark);
	}

	.area-dot {
		width: 5px;
		height: 5px;
		border-radius: 50%;
		background: var(--brand-green);
		flex-shrink: 0;
	}

	/* Peta Wrapper */
	.peta-wrapper {
		width: 100%;
		border-radius: var(--radius-sm);
		overflow: hidden;
		border: 1px solid rgba(62, 116, 53, 0.15);
		box-shadow: 0 3px 10px rgba(0, 0, 0, 0.04);
	}

	.peta-iframe {
		display: block;
		width: 100%;
		border: 0;
	}

	/* Tombol Buka Maps */
	.btn-maps {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		padding: 10px 18px;
		background: var(--brand-green);
		color: var(--white);
		border-radius: var(--radius-sm);
		font-family: var(--font-hero), system-ui, sans-serif;
		font-size: 0.875rem;
		font-weight: 700;
		text-decoration: none;
		box-shadow: 0 3px 12px rgba(62, 116, 53, 0.22);
		transition: all 0.25s cubic-bezier(0.2, 1, 0.3, 1);
		margin-top: auto;
	}

	.btn-maps:hover {
		background: var(--brand-green-dark);
		transform: translateY(-2px);
		box-shadow: 0 5px 15px rgba(62, 116, 53, 0.32);
	}

	/* ─── RESPONSIVE ───────────────────────────────────────────────── */
	@media (max-width: 768px) {
		.jadwal-card {
			padding: calc(var(--space-unit) * 3) calc(var(--space-unit) * 2.5);
		}

		.card-ikon-wrap {
			width: 44px;
			height: 44px;
			border-radius: 8px;
		}

		.card-judul {
			font-size: 1.0625rem;
		}

		.frekuensi-nilai {
			font-size: 1.125rem;
		}
	}

	/* ─── ACCESSIBILITY ────────────────────────────────────────────── */
	@media (prefers-reduced-motion: reduce) {
		.jadwal-card,
		.btn-maps,
		.area-tag {
			transition: none;
		}
		.jadwal-card:hover,
		.btn-maps:hover {
			transform: none;
		}
	}
</style>
