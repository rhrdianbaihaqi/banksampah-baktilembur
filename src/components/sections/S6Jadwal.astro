---
/**
 * S6 - Jadwal & Lokasi Penimbangan.
 * Redesign: Interactive Bento Dashboard.
 */
import Seksi from '../ui/Seksi.astro';
import { beranda, profil } from '../../data';

const { s6 } = beranda;
const { jadwalPenimbangan, areaJemput, koordinat, alamat } = profil;

const petaSrc = koordinat.terisi
	? `https://www.google.com/maps?q=${koordinat.lat},${koordinat.long}&hl=id&z=16&output=embed`
	: null;
---

<Seksi id="jadwal" eyebrow={s6.eyebrow} judul={s6.judul} latar="netral">
	<div class="bento-grid">

		<!-- BENTO 1: PETA -->
		<div class="bento-card card-map js-tilt">
			<div class="card-inner">
				<div class="map-header">
					<div class="ping-dot"></div>
					<span class="card-label">Titik Lokasi</span>
				</div>
				<div class="map-frame">
					{petaSrc ? (
						<iframe
							src={petaSrc}
							title={`Peta lokasi ${profil.nama}`}
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"
							class="map-embed"
						/>
					) : (
						<div class="map-placeholder">
							<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
							<p>{alamat.lengkap}</p>
						</div>
					)}
				</div>
				<a href={koordinat.tautanMaps} target="_blank" rel="noopener noreferrer" class="maps-btn">
					<span>{s6.tombolMaps}</span>
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
				</a>
			</div>
		</div>

		<!-- BENTO 2: FREKUENSI JADWAL -->
		<div class="bento-card card-freq js-tilt">
			<div class="card-inner">
				<div class="freq-orb"></div>
				<p class="card-label">{s6.labelJadwal}</p>
				<p class="freq-text">{jadwalPenimbangan.frekuensi}</p>
				<div class="day-row">
					{jadwalPenimbangan.hari.map(h => (
						<span class="day-tag">{h}</span>
					))}
				</div>
			</div>
		</div>

		<!-- BENTO 3: LOKASI UTAMA -->
		<div class="bento-card card-loc js-tilt">
			<div class="card-inner">
				<svg class="card-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
				<p class="card-label">{s6.labelLokasi}</p>
				<p class="card-value">{jadwalPenimbangan.lokasiUtama}</p>
			</div>
		</div>

		<!-- BENTO 4: AREA JEMPUT -->
		<div class="bento-card card-jemput js-tilt">
			<div class="card-inner">
				<svg class="card-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/></svg>
				<p class="card-label">{s6.labelJemput}</p>
				<div class="area-tags">
					{areaJemput.map(a => (
						<span class="area-tag">{a}</span>
					))}
				</div>
			</div>
		</div>

	</div>
</Seksi>

<style>
	.bento-grid {
		display: grid;
		gap: calc(var(--space-unit) * 3);
		grid-template-columns: 1fr;
		width: 100%;
		max-width: 1100px;
		margin-inline: auto;
	}

	@media (min-width: 900px) {
		.bento-grid {
			grid-template-columns: 3fr 2fr 2fr;
			grid-template-rows: auto auto;
		}
		.card-map {
			grid-column: 1 / 2;
			grid-row: 1 / 3;
		}
		.card-freq {
			grid-column: 2 / 4;
			grid-row: 1 / 2;
		}
		.card-loc {
			grid-column: 2 / 3;
			grid-row: 2 / 3;
		}
		.card-jemput {
			grid-column: 3 / 4;
			grid-row: 2 / 3;
		}
	}

	.bento-card {
		display: flex;
		transform-style: preserve-3d;
		will-change: transform;
		transition: transform 0.15s ease;
	}

	.card-inner {
		position: relative;
		width: 100%;
		display: flex;
		flex-direction: column;
		border-radius: var(--radius-lg);
		background: var(--neutral-900);
		border: 1px solid rgba(255, 255, 255, 0.1);
		padding: calc(var(--space-unit) * 3.5);
		overflow: hidden;
		box-shadow: 0 8px 32px rgba(0, 0, 0, 0.25);
		transition: border-color 0.35s ease, box-shadow 0.35s ease;
	}

	.bento-card:hover .card-inner {
		border-color: rgba(34, 197, 94, 0.5);
		box-shadow: 0 16px 48px rgba(34, 197, 94, 0.15);
	}

	.card-label {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--brand-green);
		margin: 0 0 calc(var(--space-unit) * 1.5) 0;
	}

	.card-value {
		font-size: var(--text-besar);
		font-weight: 600;
		color: #ffffff;
		margin: 0;
		line-height: 1.3;
	}

	.card-icon {
		width: 28px;
		height: 28px;
		color: var(--brand-green-light);
		margin-bottom: calc(var(--space-unit) * 2);
		transition: transform 0.3s ease;
	}

	.bento-card:hover .card-icon {
		transform: translateY(-3px) scale(1.1);
	}

	/* Map */
	.map-header {
		display: flex;
		align-items: center;
		gap: 10px;
		margin-bottom: calc(var(--space-unit) * 2.5);
	}

	.map-header .card-label {
		margin: 0;
	}

	.ping-dot {
		position: relative;
		width: 11px;
		height: 11px;
		flex-shrink: 0;
		background: var(--brand-green);
		border-radius: 50%;
	}

	.ping-dot::after {
		content: '';
		position: absolute;
		inset: -4px;
		border-radius: 50%;
		border: 2px solid var(--brand-green);
		animation: ping 2s cubic-bezier(0, 0, 0.2, 1) infinite;
	}

	@keyframes ping {
		0% { transform: scale(0.8); opacity: 1; }
		100% { transform: scale(2.8); opacity: 0; }
	}

	.map-frame {
		flex: 1;
		min-height: 220px;
		border-radius: calc(var(--radius-lg) - 8px);
		overflow: hidden;
		background: rgba(0, 0, 0, 0.25);
		margin-bottom: calc(var(--space-unit) * 2.5);
	}

	.map-embed {
		display: block;
		width: 100%;
		height: 100%;
		min-height: 220px;
		border: 0;
	}

	.map-placeholder {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		height: 100%;
		min-height: 220px;
		padding: calc(var(--space-unit) * 4);
		text-align: center;
		color: rgba(255, 255, 255, 0.5);
		gap: 12px;
	}

	.maps-btn {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 13px 18px;
		background: rgba(34, 197, 94, 0.08);
		color: var(--brand-green-light);
		border: 1px solid rgba(34, 197, 94, 0.25);
		border-radius: var(--radius-md);
		font-weight: 600;
		font-size: 0.9rem;
		text-decoration: none;
		transition: background 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;
	}

	.maps-btn:hover {
		background: var(--brand-green);
		color: var(--white);
		transform: translateY(-2px);
		box-shadow: 0 6px 16px rgba(34, 197, 94, 0.3);
	}

	/* Frekuensi */
	.card-freq .card-inner {
		justify-content: flex-end;
	}

	.freq-orb {
		position: absolute;
		top: -60%;
		right: -15%;
		width: 260px;
		height: 260px;
		background: radial-gradient(circle at center, var(--brand-green-light) 0%, transparent 65%);
		opacity: 0.1;
		filter: blur(50px);
		border-radius: 50%;
		pointer-events: none;
		transition: opacity 0.5s ease, transform 0.5s ease;
	}

	.card-freq:hover .freq-orb {
		opacity: 0.2;
		transform: scale(1.15);
	}

	.freq-text {
		font-family: var(--font-display);
		font-size: clamp(1.8rem, 3.5vw, 2.8rem);
		font-weight: 800;
		line-height: 1.1;
		margin: 0 0 calc(var(--space-unit) * 2.5) 0;
		background: linear-gradient(130deg, var(--white) 20%, var(--brand-green-light) 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
		background-size: 200% auto;
		animation: shimmer 5s linear infinite;
	}

	@keyframes shimmer {
		to { background-position: 200% center; }
	}

	.day-row {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
	}

	.day-tag {
		padding: 7px 16px;
		border-radius: 20px;
		background: rgba(255, 255, 255, 0.06);
		border: 1px solid rgba(255, 255, 255, 0.1);
		color: var(--white);
		font-weight: 600;
		font-size: 0.88rem;
		transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	.card-freq:hover .day-tag {
		background: var(--brand-green);
		border-color: var(--brand-green-light);
		transform: translateY(-3px);
		box-shadow: 0 6px 14px rgba(34, 197, 94, 0.3);
	}

	/* Area Jemput */
	.area-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-top: calc(var(--space-unit) * 1.5);
	}

	.area-tag {
		padding: 5px 12px;
		border-radius: var(--radius-sm);
		background: transparent;
		border: 1px dashed rgba(255, 255, 255, 0.35);
		color: rgba(255, 255, 255, 0.8);
		font-size: 0.82rem;
		cursor: default;
		transition: all 0.25s ease;
	}

	.area-tag:hover {
		background: rgba(255, 255, 255, 0.08);
		border-color: rgba(255, 255, 255, 0.5);
		color: var(--white);
		transform: translateY(-2px);
	}

	@media (prefers-reduced-motion: reduce) {
		.ping-dot::after,
		.freq-text { animation: none; }
		.bento-card,
		.card-inner,
		.maps-btn,
		.day-tag,
		.area-tag,
		.card-icon { transition: none; transform: none !important; }
	}
</style>

<script>
	function setupTilt() {
		const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		if (reduced) return;

		document.querySelectorAll('.js-tilt').forEach(card => {
			card.addEventListener('mousemove', e => {
				const r = card.getBoundingClientRect();
				const rx = ((e.clientY - r.top - r.height / 2) / (r.height / 2)) * -5;
				const ry = ((e.clientX - r.left - r.width / 2) / (r.width / 2)) * 5;
				card.style.transform = `perspective(900px) rotateX(${rx}deg) rotateY(${ry}deg)`;
			});

			card.addEventListener('mouseleave', () => {
				card.style.transition = 'transform 0.5s cubic-bezier(0.23,1,0.32,1)';
				card.style.transform = 'perspective(900px) rotateX(0) rotateY(0)';
				setTimeout(() => { card.style.transition = 'transform 0.15s ease'; }, 500);
			});
		});
	}

	document.addEventListener('astro:page-load', setupTilt);
	document.addEventListener('DOMContentLoaded', setupTilt);
</script>