---
/**
 * S6 — Jadwal & Lokasi Penimbangan.
 * Layout 2-kolom: info jadwal di kiri, area layanan di kanan.
 * Google Maps dihapus (koordinat belum terisi, PRD §17 item 2).
 * Ikon: calendar, map-pin, truck, home, book-open — semua terdaftar di Ikon.astro.
 */
import Seksi from '../ui/Seksi.astro';
import Ikon from '../ui/Ikon.astro';
import { beranda, profil } from '../../data';

const { s6 } = beranda;
const { jadwalPenimbangan, areaJemput } = profil;
---

<Seksi id="jadwal" eyebrow={s6.eyebrow} judul={s6.judul} latar="netral">
	<div class="jadwal-grid">

		<!-- KOLOM KIRI: Jadwal & Lokasi -->
		<div class="jadwal-info">

			<!-- Jadwal Penimbangan -->
			<div class="info-blok blok-utama">
				<div class="info-header">
					<div class="ikon-wrap">
						<Ikon nama="calendar" ukuran={20} />
					</div>
					<h3 class="info-label">{s6.labelJadwal}</h3>
				</div>
				<p class="frekuensi-teks">{jadwalPenimbangan.frekuensi}</p>
				<div class="hari-tags">
					{jadwalPenimbangan.hari.map(h => (
						<span class="hari-tag">{h}</span>
					))}
				</div>
			</div>

			<!-- Lokasi Utama -->
			<div class="info-blok">
				<div class="info-header">
					<div class="ikon-wrap">
						<Ikon nama="map-pin" ukuran={20} />
					</div>
					<h3 class="info-label">{s6.labelLokasi}</h3>
				</div>
				<p class="info-nilai">{jadwalPenimbangan.lokasiUtama}</p>
			</div>

		</div>

		<!-- KOLOM KANAN: Area Layanan Jemput -->
		<div class="jadwal-area">
			<div class="info-blok">
				<div class="info-header">
					<div class="ikon-wrap">
						<Ikon nama="truck" ukuran={20} />
					</div>
					<h3 class="info-label">{s6.labelJemput}</h3>
				</div>
				<div class="area-tags">
					{areaJemput.map(a => (
						<span class="area-tag">
							<span class="area-dot" aria-hidden="true"></span>
							{a}
						</span>
					))}
				</div>
			</div>
		</div>

	</div>
</Seksi>

<style>
	/* ─── LAYOUT UTAMA ─────────────────────────────────────────────── */
	.jadwal-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: calc(var(--space-unit) * 6);
		align-items: start;
	}

	@media (min-width: 900px) {
		.jadwal-grid {
			grid-template-columns: 1fr 1fr;
			gap: calc(var(--space-unit) * 8);
		}
	}

	/* ─── KOLOM INFO ───────────────────────────────────────────────── */
	.jadwal-info {
		display: flex;
		flex-direction: column;
		gap: calc(var(--space-unit) * 4);
	}

	.jadwal-area {
		display: flex;
		flex-direction: column;
	}

	/* ─── BLOK INFO ────────────────────────────────────────────────── */
	.info-blok {
		display: flex;
		flex-direction: column;
		gap: calc(var(--space-unit) * 2);
		padding: calc(var(--space-unit) * 4);
		background: var(--white);
		border: 1px solid var(--border);
		border-radius: var(--radius-md);
		box-shadow: 0 4px 20px rgba(26, 29, 26, 0.05);
		transition: transform 0.25s ease, box-shadow 0.25s ease;
	}

	.info-blok:hover {
		transform: translateY(-3px);
		box-shadow: 0 10px 32px rgba(26, 29, 26, 0.09);
	}

	/* Blok utama (Jadwal) mendapat aksen warna lebih kuat */
	.blok-utama {
		border-left: 4px solid var(--brand-green);
	}

	.info-header {
		display: flex;
		align-items: center;
		gap: calc(var(--space-unit) * 1.5);
	}

	.ikon-wrap {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 40px;
		height: 40px;
		background: var(--brand-green-light);
		color: var(--brand-green);
		border-radius: 50%;
		flex-shrink: 0;
	}

	.info-label {
		margin: 0;
		font-family: var(--font-hero), system-ui, sans-serif;
		font-size: var(--text-isi);
		font-weight: 700;
		color: var(--neutral-900);
	}

	.frekuensi-teks {
		margin: 0;
		font-family: var(--font-display), Georgia, serif;
		font-size: clamp(1.6rem, 3.5vw, 2.25rem);
		font-weight: 800;
		color: var(--brand-green-dark);
		line-height: 1.2;
	}

	.info-nilai {
		margin: 0;
		font-family: var(--font-isi), system-ui, sans-serif;
		font-size: var(--text-isi);
		color: var(--neutral-700);
		line-height: 1.55;
	}

	/* ─── HARI TAGS ────────────────────────────────────────────────── */
	.hari-tags {
		display: flex;
		flex-wrap: wrap;
		gap: calc(var(--space-unit) * 1);
	}

	.hari-tag {
		padding: calc(var(--space-unit) * 0.75) calc(var(--space-unit) * 2);
		background: var(--brand-green);
		color: var(--white);
		border-radius: 999px;
		font-family: var(--font-isi), system-ui, sans-serif;
		font-size: var(--text-kecil);
		font-weight: 600;
		box-shadow: 0 2px 8px rgba(62, 116, 53, 0.22);
	}

	/* ─── AREA TAGS ────────────────────────────────────────────────── */
	.area-tags {
		display: flex;
		flex-direction: column;
		gap: calc(var(--space-unit) * 0.75);
	}

	.area-tag {
		display: flex;
		align-items: center;
		gap: calc(var(--space-unit) * 1.25);
		padding: calc(var(--space-unit) * 1.25) calc(var(--space-unit) * 1.5);
		border-radius: var(--radius-sm);
		font-family: var(--font-isi), system-ui, sans-serif;
		font-size: var(--text-kecil);
		font-weight: 500;
		color: var(--neutral-700);
		background: var(--neutral-50);
		border: 1px solid var(--border);
		transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
	}

	.area-tag:hover {
		background: var(--brand-green-light);
		border-color: var(--brand-green);
		color: var(--brand-green-dark);
	}

	.area-dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--brand-green);
		flex-shrink: 0;
	}

	/* ─── RESPONSIVE MOBILE ────────────────────────────────────────── */
	@media (max-width: 767px) {
		.info-blok {
			padding: calc(var(--space-unit) * 3);
		}

		.frekuensi-teks {
			font-size: 1.5rem;
		}
	}

	/* ─── ACCESSIBILITY ────────────────────────────────────────────── */
	@media (prefers-reduced-motion: reduce) {
		.info-blok {
			transition: none;
		}
		.info-blok:hover {
			transform: none;
		}
		.area-tag {
			transition: none;
		}
	}

	@media (prefers-reduced-transparency: reduce) {
		.info-blok {
			background: var(--white);
			box-shadow: none;
		}
	}
</style>