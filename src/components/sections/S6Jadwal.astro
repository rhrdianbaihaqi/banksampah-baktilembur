---
/**
 * S6 - Jadwal & Lokasi Penimbangan.
 * Redesign: Layout 2-kolom terbuka (senada dengan S3Latar), bersih, dan fleksibel.
 */
import Seksi from '../ui/Seksi.astro';
import Ikon from '../ui/Ikon.astro';
import { beranda, profil } from '../../data';

const { s6 } = beranda;
const { jadwalPenimbangan, areaJemput, koordinat, alamat } = profil;

const petaSrc = koordinat.terisi
	? `https://www.google.com/maps?q=${koordinat.lat},${koordinat.long}&hl=id&z=16&output=embed`
	: null;
---

<Seksi id="jadwal" eyebrow={s6.eyebrow} judul={s6.judul} latar="netral">
	<div class="jadwal-grid">
		
		<!-- KOLOM KIRI: Informasi Jadwal & Lokasi -->
		<div class="jadwal-info">
			<!-- Frekuensi -->
			<div class="info-blok blok-utama">
				<div class="info-header">
					<div class="ikon-wrap">
						<Ikon nama="calendar" ukuran={24} />
					</div>
					<h3 class="info-label">{s6.labelJadwal}</h3>
				</div>
				<p class="frekuensi-teks">{jadwalPenimbangan.frekuensi}</p>
				<div class="hari-tags">
					{jadwalPenimbangan.hari.map(h => (
						<span class="hari-tag">{h}</span>
					))}
				</div>
			</div>

			<!-- Lokasi Utama -->
			<div class="info-blok">
				<div class="info-header">
					<div class="ikon-wrap">
						<Ikon nama="map-pin" ukuran={20} />
					</div>
					<h3 class="info-label">{s6.labelLokasi}</h3>
				</div>
				<p class="info-nilai">{jadwalPenimbangan.lokasiUtama}</p>
			</div>

			<!-- Area Jemput -->
			<div class="info-blok">
				<div class="info-header">
					<div class="ikon-wrap">
						<Ikon nama="truck" ukuran={20} />
					</div>
					<h3 class="info-label">{s6.labelJemput}</h3>
				</div>
				<div class="area-tags">
					{areaJemput.map(a => (
						<span class="area-tag">{a}</span>
					))}
				</div>
			</div>
		</div>

		<!-- KOLOM KANAN: Peta Lokasi -->
		<div class="jadwal-peta">
			<div class="peta-wrapper">
				{petaSrc ? (
					<iframe
						src={petaSrc}
						title={`Peta lokasi ${profil.nama}`}
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
						class="iframe-peta"
					/>
				) : (
					<div class="peta-placeholder">
						<Ikon nama="map-pin" ukuran={48} />
						<p>{alamat.lengkap}</p>
					</div>
				)}
				
				<div class="peta-aksi">
					<a href={koordinat.tautanMaps} target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-maps">
						<span>{s6.tombolMaps}</span>
						<Ikon nama="external-link" ukuran={16} />
					</a>
				</div>
			</div>
		</div>

	</div>
</Seksi>

<style>
	/* Layout Utama */
	.jadwal-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: calc(var(--space-unit) * 6);
		align-items: stretch;
	}

	@media (min-width: 900px) {
		.jadwal-grid {
			grid-template-columns: 1fr 1.2fr;
			gap: calc(var(--space-unit) * 8);
		}
	}

	/* Kolom Kiri: Info */
	.jadwal-info {
		display: flex;
		flex-direction: column;
		gap: calc(var(--space-unit) * 4);
	}

	.info-blok {
		display: flex;
		flex-direction: column;
		gap: calc(var(--space-unit) * 1.5);
		padding: calc(var(--space-unit) * 3);
		background: #ffffff;
		border: 1px solid var(--neutral-200);
		border-radius: var(--radius-lg);
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
		transition: transform 0.3s ease, box-shadow 0.3s ease;
	}

	.info-blok:hover {
		transform: translateY(-2px);
		box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
	}

	.info-header {
		display: flex;
		align-items: center;
		gap: 12px;
	}

	.ikon-wrap {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 40px;
		height: 40px;
		background: var(--brand-green-light);
		color: var(--brand-green);
		border-radius: 50%;
	}

	.info-label {
		margin: 0;
		font-family: var(--font-hero), system-ui, sans-serif;
		font-size: 1.1rem;
		font-weight: 700;
		color: var(--neutral-900);
	}

	.frekuensi-teks {
		margin: 0;
		font-family: var(--font-display), system-ui, sans-serif;
		font-size: clamp(1.8rem, 4vw, 2.5rem);
		font-weight: 800;
		color: var(--brand-green-dark);
		line-height: 1.2;
	}

	.info-nilai {
		margin: 0;
		font-size: 1.05rem;
		color: var(--neutral-700);
		line-height: 1.5;
	}

	/* Tags (Hari & Area) */
	.hari-tags, .area-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-top: 4px;
	}

	.hari-tag {
		padding: 6px 14px;
		background: var(--brand-green);
		color: var(--white);
		border-radius: 20px;
		font-size: 0.85rem;
		font-weight: 600;
		box-shadow: 0 2px 8px rgba(62, 116, 53, 0.2);
	}

	.area-tag {
		padding: 6px 14px;
		background: var(--neutral-100);
		color: var(--neutral-800);
		border: 1px solid var(--neutral-200);
		border-radius: 20px;
		font-size: 0.85rem;
		font-weight: 500;
	}

	/* Kolom Kanan: Peta */
	.jadwal-peta {
		display: flex;
		flex-direction: column;
		height: 100%;
	}

	.peta-wrapper {
		position: relative;
		display: flex;
		flex-direction: column;
		flex: 1; /* Mengisi ruang yang tersedia tanpa dikunci tingginya */
		min-height: 400px;
		background: #ffffff;
		border: 1px solid var(--neutral-200);
		border-radius: var(--radius-lg);
		padding: calc(var(--space-unit) * 2);
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
	}

	.iframe-peta {
		width: 100%;
		height: 100%;
		flex: 1; /* Fleksibel */
		min-height: 300px;
		border: none;
		border-radius: calc(var(--radius-lg) - 8px);
		background: var(--neutral-100);
	}

	.peta-placeholder {
		flex: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 16px;
		background: var(--neutral-100);
		border-radius: calc(var(--radius-lg) - 8px);
		color: var(--neutral-500);
		text-align: center;
		padding: 24px;
	}

	.peta-aksi {
		margin-top: calc(var(--space-unit) * 2);
		display: flex;
		justify-content: flex-end;
	}

	.btn-maps {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 10px 20px;
		border-radius: 8px;
		font-weight: 600;
		text-decoration: none;
	}
</style>