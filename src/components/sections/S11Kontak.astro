---
/**
 * S11 — Dukung & Hubungi Kami. Latar: netral (desain baru).
 *
 * Merombak layout menjadi Card Interaktif (selectable cards) bergaya bento.
 * Seluruh kotak dapat ditekan langsung menuju WhatsApp terkait.
 */
import Seksi from '../ui/Seksi.astro';
import Ikon from '../ui/Ikon.astro';
import { beranda, profil, ctaWhatsapp } from '../../data';

const { s11 } = beranda;
const { alamat, kontak, sosmed } = profil;
---

<Seksi
	id="hubungi"
	eyebrow={s11.eyebrow}
	judul={s11.judul}
	latar="netral"
>
	<div class="kontak-kontainer">
		<ul class="jalur-cards">
			{
				s11.jalur.map((j) => {
					// Panggil utilitas untuk mendapatkan URL berdasarkan ID cta (misal: "halo-warga")
					const ctaData = ctaWhatsapp(j.cta);
					return (
						<li>
							<a href={ctaData.url} class="kartu-jalur" target="_blank" rel="noopener noreferrer" data-cta data-ga4={ctaData.eventGa4}>
								<div class="kartu-header">
									<span class="eyebrow-jalur">{j.eyebrow}</span>
									<span class="ikon-panah-wrap"><Ikon nama="arrow-right" ukuran={20} /></span>
								</div>
								<h3 class="judul-jalur">{j.judul}</h3>
								<p class="ket">{j.keterangan}</p>
							</a>
						</li>
					);
				})
			}
		</ul>

		<div class="bawah">
			<address class="blok-bawah kontak">
				<h3 class="eyebrow">{s11.labelKontak}</h3>
				<p class="alamat">{alamat.lengkap}</p>
				<ul class="tautan-kontak">
					<li>
						<a href={`mailto:${kontak.email}`} data-cta>{kontak.email}</a>
					</li>
				</ul>
				<ul class="daftar-sosmed">
					{
						sosmed.map((s) => (
							<li>
								<a
									href={s.url}
									target="_blank"
									rel="noopener noreferrer"
									aria-label={s.nama}
									data-cta
									data-ga4="klik_sosmed"
									class="ikon-bulat"
								>
									<Ikon nama={s.nama.toLowerCase()} ukuran={20} />
								</a>
							</li>
						))
					}
				</ul>
			</address>
		</div>
	</div>
</Seksi>

<style>
	.kontak-kontainer {
		display: flex;
		flex-direction: column;
		gap: calc(var(--space-unit) * 7);
	}

	.jalur-cards {
		display: grid;
		gap: calc(var(--space-unit) * 3);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.kartu-jalur {
		display: flex;
		flex-direction: column;
		height: 100%;
		position: relative;
		overflow: hidden;
		padding: calc(var(--space-unit) * 4);
		border: 1px solid rgba(58, 65, 58, 0.12);
		border-radius: var(--radius-lg);
		background: linear-gradient(180deg, rgba(255,255,255,0.96), rgba(249,250,248,0.9));
		box-shadow: 0 10px 26px rgba(26, 29, 26, 0.04);
		text-decoration: none;
		color: inherit;
		transition: transform 0.28s cubic-bezier(0.2, 0.9, 0.2, 1), box-shadow 0.28s ease, border-color 0.28s ease;
	}

	.kartu-jalur::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 4px;
		background: linear-gradient(90deg, var(--brand-green) 0%, rgba(62,116,53,0.45) 100%);
		transform: scaleX(0.18);
		transform-origin: left;
		opacity: 0.9;
		transition: transform 0.3s ease;
	}

	.kartu-jalur:hover,
	.kartu-jalur:focus-visible {
		transform: translateY(-6px);
		box-shadow: 0 18px 36px rgba(26, 29, 26, 0.09);
		border-color: rgba(62, 116, 53, 0.25);
	}

	.kartu-jalur:hover::before,
	.kartu-jalur:focus-visible::before {
		transform: scaleX(1);
	}

	.kartu-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: var(--space-unit);
		margin-bottom: calc(var(--space-unit) * 3);
	}

	.eyebrow-jalur {
		font-family: var(--font-mono), monospace;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--brand-green-dark);
	}

	.ikon-panah-wrap {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 32px;
		height: 32px;
		border-radius: 50%;
		background: rgba(62, 116, 53, 0.08);
		color: var(--brand-green-dark);
		transition: transform 0.25s ease, background-color 0.25s ease, color 0.25s ease;
	}

	.kartu-jalur:hover .ikon-panah-wrap,
	.kartu-jalur:focus-visible .ikon-panah-wrap {
		background: var(--brand-green-dark);
		color: var(--white);
		transform: translateX(4px);
	}

	.judul-jalur {
		margin: 0 0 calc(var(--space-unit) * 2) 0;
		font-family: var(--font-display), Georgia, serif;
		font-size: clamp(2rem, 1.4vw + 1.3rem, 2.5rem);
		font-weight: 700;
		font-style: italic;
		line-height: 1.08;
		letter-spacing: -0.04em;
		color: var(--neutral-900);
	}

	.ket {
		margin: 0;
		color: var(--neutral-600);
		font-size: var(--text-isi);
		line-height: 1.7;
		flex-grow: 1;
		max-width: 32ch;
	}

	.bawah {
		display: grid;
		gap: calc(var(--space-unit) * 5);
		padding-top: calc(var(--space-unit) * 5);
		border-top: 1px solid rgba(58, 65, 58, 0.12);
	}

	.blok-bawah {
		display: flex;
		flex-direction: column;
		gap: calc(var(--space-unit) * 2.5);
	}

	.eyebrow {
		margin: 0;
		font-family: var(--font-mono), monospace;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--neutral-600);
	}

	.chip-baris {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-unit);
	}

	.kontak {
		font-style: normal;
	}

	.alamat {
		margin: 0;
		max-width: 36ch;
		color: var(--neutral-800);
		font-size: var(--text-besar);
		line-height: 1.7;
	}

	.tautan-kontak {
		display: flex;
		flex-direction: column;
		gap: calc(var(--space-unit) * 1);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.tautan-kontak a {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: calc(var(--space-unit) * 1.5) calc(var(--space-unit) * 2);
		border-radius: var(--radius-sm);
		background: rgba(62, 116, 53, 0.08);
		color: var(--brand-green-dark);
		font-weight: 700;
		text-decoration: none;
		transition: background-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
	}

	.tautan-kontak a:hover,
	.tautan-kontak a:focus-visible {
		background: rgba(62, 116, 53, 0.12);
		color: var(--brand-green);
		transform: translateY(-1px);
	}

	.daftar-sosmed {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin: calc(var(--space-unit) * 1) 0 0;
		padding: 0;
		list-style: none;
	}

	.ikon-bulat {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.9);
		border: 1px solid rgba(58, 65, 58, 0.1);
		color: var(--brand-green-dark);
		box-shadow: 0 8px 18px rgba(26, 29, 26, 0.04);
		text-decoration: none;
		transition: transform 0.2s ease, background-color 0.2s ease, color 0.2s ease, box-shadow 0.2s ease;
	}

	.ikon-bulat:hover,
	.ikon-bulat:focus-visible {
		background-color: var(--brand-green-dark);
		color: var(--white);
		transform: translateY(-2px);
		box-shadow: 0 12px 22px rgba(26, 29, 26, 0.08);
	}

	@media (min-width: 768px) {
		.jalur-cards {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}

		.bawah {
			grid-template-columns: 1.05fr 1fr;
			gap: calc(var(--space-unit) * 8);
		}
	}
</style>
