interface Props {
	nama: string;
	ukuran?: number;
}

const { nama, ukuran = 28 } = Astro.props;
const jalur = peta[nama];
const isBrand = ['instagram', 'tiktok'].includes(nama);
---

{
	jalur && (
		<svg
			xmlns="http://www.w3.org/2000/svg"
			width={ukuran}
			height={ukuran}
			viewBox="0 0 24 24"
			fill={isBrand ? "currentColor" : "none"}
			stroke={isBrand ? "none" : "currentColor"}
			stroke-width={isBrand ? "0" : "1.5"}
			stroke-linecap="round"
			stroke-linejoin="round"
			aria-hidden="true"
			focusable="false"
		>
			{jalur.map((d) => (
				<path d={d} />
			))}
		</svg>
	)
}
