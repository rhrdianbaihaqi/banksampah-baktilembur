---
import { Image } from 'astro:assets';

const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/latarbelakang/*.{jpeg,jpg,png,gif,webp,avif}', { eager: true });
const imageList = Object.values(images).map(mod => mod.default);
---

<div class="slider-container" data-slider>
	<div class="slider-track" data-track>
		{imageList.map((img, index) => (
			<div class="slide" data-index={index} aria-hidden={index === 0 ? "false" : "true"}>
				<Image 
					src={img} 
					alt="" 
					widths={[640, 960, 1280]} 
					sizes="(max-width: 900px) 100vw, 50vw" 
					class="slide-image"
					loading={index === 0 ? "eager" : "lazy"}
					decoding={index === 0 ? "sync" : "async"}
				/>
				<div class="scrim-lembut scrim-overlay"></div>
			</div>
		))}
	</div>

	{imageList.length > 1 && (
		<>
			<button class="nav-btn prev" aria-label="Previous image" data-prev>
				<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
			</button>
			<button class="nav-btn next" aria-label="Next image" data-next>
				<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
			</button>

			<div class="dots-container">
				{imageList.map((_, index) => (
					<button class="dot" data-index={index} aria-label={`Go to slide ${index + 1}`} aria-current={index === 0 ? "true" : "false"}></button>
				))}
			</div>
		</>
	)}
</div>

<style>
	.slider-container {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		background: var(--brand-green-dark); /* fallback */
	}

	.slider-track {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}

	.slide {
		position: absolute;
		inset: 0;
		opacity: 0;
		/* fade + slightly slide from right to left or just general slide */
		transform: translateX(10px);
		transition: opacity 0.6s ease-out, transform 0.6s ease-out;
		pointer-events: none;
	}

	.slide[aria-hidden="false"] {
		opacity: 1;
		transform: translateX(0);
		pointer-events: auto;
		z-index: 1;
	}

	.slide-image {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	
	.scrim-overlay {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}

	.nav-btn {
		position: absolute;
		top: 50%;
		transform: translateY(-50%);
		z-index: 10;
		background: var(--glass-light);
		border: 1px solid var(--glass-border);
		color: var(--neutral-900);
		width: 44px;
		height: 44px;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		opacity: 0;
		transition: opacity 0.3s ease, background 0.2s ease, transform 0.2s ease;
		backdrop-filter: blur(var(--glass-blur-mobile));
		/* Prevent button from shrinking */
		min-width: 44px;
		min-height: 44px;
		padding: 0;
	}

	.slider-container:hover .nav-btn,
	.nav-btn:focus-visible {
		opacity: 1;
	}

	.nav-btn:hover {
		background: var(--white);
		transform: translateY(-50%) scale(1.05);
	}

	.prev {
		left: var(--space-unit);
	}

	.next {
		right: var(--space-unit);
	}

	.dots-container {
		position: absolute;
		bottom: calc(var(--space-unit) * 2);
		left: 50%;
		transform: translateX(-50%);
		z-index: 10;
		display: flex;
		gap: var(--space-unit);
		background: var(--glass-dark);
		padding: 6px 12px;
		border-radius: var(--radius-lg);
		backdrop-filter: blur(var(--glass-blur-mobile));
	}

	.dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--glass-light);
		border: none;
		cursor: pointer;
		padding: 0;
		transition: background 0.3s ease, transform 0.3s ease;
		min-width: 8px; 
		min-height: 8px;
	}

	.dot:hover, .dot:focus-visible {
		background: var(--white);
	}

	.dot[aria-current="true"] {
		background: var(--white);
		transform: scale(1.4);
	}
	
	@media (max-width: 768px) {
		.nav-btn {
			opacity: 1; /* Always visible on mobile for discoverability */
			background: var(--glass-light-strong);
			width: 36px;
			height: 36px;
			min-width: 36px;
			min-height: 36px;
		}
		
		.nav-btn svg {
			width: 20px;
			height: 20px;
		}
		
		.dots-container {
			bottom: var(--space-unit);
		}
	}
	
	@media (prefers-reduced-motion: reduce) {
		.slide {
			transition: opacity 0.4s ease;
			transform: none;
		}
		.nav-btn:hover {
			transform: translateY(-50%);
		}
		.dot[aria-current="true"] {
			transform: none;
		}
	}
</style>

<script>
	class ImageSlider {
		constructor(container) {
			this.container = container;
			this.slides = container.querySelectorAll('.slide');
			this.dots = container.querySelectorAll('.dot');
			this.prevBtn = container.querySelector('[data-prev]');
			this.nextBtn = container.querySelector('[data-next]');
			
			this.currentIndex = 0;
			this.totalSlides = this.slides.length;
			this.autoplayInterval = null;
			this.autoplayDelay = 4500; // 4-5 seconds as requested
			
			this.init();
		}
		
		init() {
			if (this.totalSlides <= 1) return;
			
			if (this.prevBtn) {
				this.prevBtn.addEventListener('click', () => {
					this.prev();
					this.resetAutoplay();
				});
			}
			
			if (this.nextBtn) {
				this.nextBtn.addEventListener('click', () => {
					this.next();
					this.resetAutoplay();
				});
			}
			
			this.dots.forEach((dot, index) => {
				dot.addEventListener('click', () => {
					this.goToSlide(index);
					this.resetAutoplay();
				});
			});
			
			// Pause on hover/interaction
			this.container.addEventListener('mouseenter', () => this.pauseAutoplay());
			this.container.addEventListener('mouseleave', () => this.startAutoplay());
			
			this.container.addEventListener('touchstart', () => this.pauseAutoplay(), { passive: true });
			this.container.addEventListener('touchend', () => {
				setTimeout(() => this.startAutoplay(), 1000);
			}, { passive: true });

			this.startAutoplay();
		}
		
		updateUI() {
			this.slides.forEach((slide, index) => {
				slide.setAttribute('aria-hidden', index === this.currentIndex ? 'false' : 'true');
			});
			
			this.dots.forEach((dot, index) => {
				dot.setAttribute('aria-current', index === this.currentIndex ? 'true' : 'false');
			});
		}
		
		next() {
			this.currentIndex = (this.currentIndex + 1) % this.totalSlides;
			this.updateUI();
		}
		
		prev() {
			this.currentIndex = (this.currentIndex - 1 + this.totalSlides) % this.totalSlides;
			this.updateUI();
		}
		
		goToSlide(index) {
			this.currentIndex = index;
			this.updateUI();
		}
		
		startAutoplay() {
			this.pauseAutoplay();
			this.autoplayInterval = setInterval(() => this.next(), this.autoplayDelay);
		}
		
		pauseAutoplay() {
			if (this.autoplayInterval) {
				clearInterval(this.autoplayInterval);
				this.autoplayInterval = null;
			}
		}
		
		resetAutoplay() {
			this.startAutoplay();
		}
	}
	
	const initSliders = () => {
		const sliders = document.querySelectorAll('[data-slider]');
		sliders.forEach(slider => {
			// Prevent multiple initialization on the same element
			if (!slider.hasAttribute('data-initialized')) {
				new ImageSlider(slider);
				slider.setAttribute('data-initialized', 'true');
			}
		});
	};
	
	// Support for Astro View Transitions
	document.addEventListener('astro:page-load', initSliders);
	// Initial load support
	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initSliders);
	} else {
		initSliders();
	}
</script>
