---
/**
 * Footer — Informasi kontak dan navigasi
 * Mengikuti arahan layout 4 kolom dengan latar belakang gelap.
 */
import { Image } from 'astro:assets';
import Ikon from './ui/Ikon.astro';
import { profil, nav } from '../data';
import logoBankSampah from '../assets/images/logo/logobanksampah.png';

const { kontak, sosmed, nama, diresmikan } = profil;
const currentYear = new Date().getFullYear();
const startYear = new Date(diresmikan).getFullYear();
---

<footer class="footer" role="contentinfo">
	<div class="footer-content">
		
		<!-- FOOTER TOP: 4 Kolom -->
		<div class="footer-top">
			
			<!-- Kolom 1: Brand & Tagline -->
			<div class="footer-section brand-section">
				<div class="brand-header">
					<Image
						src={logoBankSampah}
						alt={`Logo ${nama}`}
						width={44}
						height={44}
						class="footer-logo"
						loading="lazy"
						decoding="async"
					/>
					<p class="brand-name">{nama}</p>
				</div>
				<p class="brand-desc">
					{profil.tagline}. {profil.misi[0]}
				</p>
			</div>

			<!-- Kolom 2: Tautan Cepat -->
			<div class="footer-section">
				<p class="footer-heading">Tautan Cepat</p>
				<ul class="footer-links">
					{nav.tautan.map((item) => (
						<li><a href={item.href}>{item.label}</a></li>
					))}
				</ul>
			</div>

			<!-- Kolom 3: Layanan -->
			<div class="footer-section">
				<p class="footer-heading">Layanan</p>
				<ul class="footer-links">
					<li><a href={`https://wa.me/${kontak.whatsapp.nomorInternasional}`} target="_blank" rel="noopener noreferrer">Pendaftaran Nasabah</a></li>
					<li><a href="#alur">Informasi Bank Sampah</a></li>
					<li><a href="#jadwal">Lokasi & Jadwal</a></li>
				</ul>
			</div>

			<!-- Kolom 4: Kontak -->
			<div class="footer-section">
				<p class="footer-heading">Kontak</p>
				
				<div class="kontak-item">
					<strong class="kontak-label">Alamat:</strong>
					<p class="kontak-teks">{profil.alamat.lengkap}</p>
				</div>
				
				<div class="kontak-item mt-4">
					<strong class="kontak-label">Kontak (WhatsApp & Email):</strong>
					<p class="kontak-teks">{kontak.whatsapp.nomorLokal}<br/>{kontak.email}</p>
				</div>
			</div>

		</div>

		<!-- FOOTER DIVIDER -->
		<div class="footer-divider"></div>

		<!-- FOOTER BOTTOM: Copyright & Sosmed -->
		<div class="footer-bottom">
			<div class="footer-copyright">
				<p class="copyright-text">
					© {currentYear} {nama}. Didigitalisasikan melalui Program Kerja KKN Kelompok 10.
				</p>
			</div>
			
			<div class="footer-sosmed-bottom">
				<div class="sosmed-bottom-group">
					<span class="sosmed-bottom-label">Bank Sampah:</span>
					{sosmed.filter(s => s.kelompok === 'banksampah').map(s => (
						<a
							href={s.url}
							target="_blank"
							rel="noopener noreferrer"
							class="sosmed-icon-link"
							aria-label={`${s.nama} — ${s.handle}`}
							title={`${s.nama} ${s.handle}`}
						>
							<Ikon nama={s.ikon} ukuran={20} />
						</a>
					))}
				</div>
				<span class="sosmed-bottom-divider">|</span>
				<div class="sosmed-bottom-group">
					<span class="sosmed-bottom-label">KKN Kel. 10:</span>
					{sosmed.filter(s => s.kelompok === 'kkn').map(s => (
						<a
							href={s.url}
							target="_blank"
							rel="noopener noreferrer"
							class="sosmed-icon-link"
							aria-label={`${s.nama} — ${s.handle}`}
							title={`${s.nama} ${s.handle}`}
						>
							<Ikon nama={s.ikon} ukuran={20} />
						</a>
					))}
				</div>
			</div>
		</div>

	</div>
</footer>

<style>
	/* ─── FOOTER WRAPPER ──────────────────────────────────────────────── */
	.footer {
		background: var(--neutral-900);
		padding: calc(var(--space-unit) * 8) calc(var(--space-unit) * 3);
	}

	@media (min-width: 768px) {
		.footer {
			padding: calc(var(--space-unit) * 10) calc(var(--space-unit) * 6);
		}
	}

	.footer-content {
		max-width: 1200px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		gap: calc(var(--space-unit) * 6);
	}

	/* ─── FOOTER TOP (4 KOLOM) ────────────────────────────────────────── */
	.footer-top {
		display: grid;
		grid-template-columns: 1fr;
		gap: calc(var(--space-unit) * 6);
	}

	@media (min-width: 640px) {
		.footer-top {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (min-width: 1024px) {
		.footer-top {
			grid-template-columns: 2fr 1fr 1fr 1.5fr;
			gap: calc(var(--space-unit) * 4);
		}
	}

	.footer-section {
		display: flex;
		flex-direction: column;
		gap: calc(var(--space-unit) * 2);
	}

	/* ─── KOLOM 1: BRAND ─────────────────────────────────────────────── */
	.brand-section {
		padding-right: calc(var(--space-unit) * 4);
	}

	.brand-header {
		display: flex;
		align-items: center;
		gap: 12px;
	}

	.footer-logo {
		background: var(--white);
		border-radius: 8px;
		padding: 4px;
	}

	.brand-name {
		margin: 0;
		font-family: var(--font-hero), system-ui, sans-serif;
		font-size: 1.125rem;
		font-weight: 700;
		color: var(--white);
		line-height: 1.3;
	}

	.brand-desc {
		margin: 0;
		font-family: var(--font-isi), system-ui, sans-serif;
		font-size: 0.875rem;
		line-height: 1.6;
		color: var(--neutral-100);
		opacity: 0.85;
	}

	/* ─── HEADING KOLOM ──────────────────────────────────────────────── */
	.footer-heading {
		margin: 0;
		font-family: var(--font-hero), system-ui, sans-serif;
		font-size: 1rem;
		font-weight: 700;
		color: var(--white);
	}

	/* ─── LINKS (TAUTAN & LAYANAN) ───────────────────────────────────── */
	.footer-links {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	.footer-links a {
		font-family: var(--font-isi), system-ui, sans-serif;
		font-size: 0.875rem;
		color: var(--neutral-100);
		text-decoration: none;
		opacity: 0.8;
		transition: opacity 0.2s ease, color 0.2s ease;
	}

	.footer-links a:hover {
		opacity: 1;
		color: var(--white);
		text-decoration: underline;
	}

	/* ─── KONTAK ─────────────────────────────────────────────────────── */
	.kontak-item {
		display: flex;
		flex-direction: column;
		gap: 4px;
	}

	.mt-4 {
		margin-top: 16px;
	}

	.kontak-label {
		font-family: var(--font-isi), system-ui, sans-serif;
		font-size: 0.875rem;
		font-weight: 700;
		color: var(--white);
	}

	.kontak-teks {
		margin: 0;
		font-family: var(--font-isi), system-ui, sans-serif;
		font-size: 0.875rem;
		line-height: 1.6;
		color: var(--neutral-100);
		opacity: 0.85;
	}

	/* ─── FOOTER DIVIDER ──────────────────────────────────────────────── */
	.footer-divider {
		height: 1px;
		background: rgba(255, 255, 255, 0.15);
	}

	/* ─── FOOTER BOTTOM ──────────────────────────────────────────────── */
	.footer-bottom {
		display: flex;
		flex-direction: column;
		gap: calc(var(--space-unit) * 3);
		align-items: center;
		text-align: center;
	}

	@media (min-width: 768px) {
		.footer-bottom {
			flex-direction: row;
			justify-content: space-between;
			text-align: left;
		}
	}

	.copyright-text {
		margin: 0;
		font-family: var(--font-isi), system-ui, sans-serif;
		font-size: 0.8125rem;
		color: var(--neutral-100);
		opacity: 0.7;
	}

	.footer-sosmed-bottom {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		justify-content: center;
		gap: calc(var(--space-unit) * 2);
	}

	.sosmed-bottom-group {
		display: flex;
		align-items: center;
		gap: calc(var(--space-unit) * 1.5);
	}

	.sosmed-bottom-label {
		font-family: var(--font-isi), system-ui, sans-serif;
		font-size: 0.75rem;
		font-weight: 600;
		color: var(--neutral-100);
		opacity: 0.5;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.sosmed-bottom-divider {
		color: var(--neutral-100);
		opacity: 0.2;
		font-size: 0.9rem;
	}

	.sosmed-icon-link {
		color: var(--neutral-100);
		opacity: 0.7;
		transition: opacity 0.2s ease, color 0.2s ease, transform 0.2s ease;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.sosmed-icon-link:hover {
		opacity: 1;
		color: var(--white);
		transform: translateY(-2px);
	}
</style>
